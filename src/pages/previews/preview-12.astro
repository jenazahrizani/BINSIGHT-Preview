      /* RESPONSIVE 1180 */
      @media (max-width: 1180px) {
        .container {
          width: min(calc(100% - 48px), var(--page));
        }

        .header-inner {
          grid-template-columns: 1fr auto;
        }

        .main-nav {
          display: none;
        }

        .menu {
          display: flex;
        }

        .hero__layout {
          grid-template-columns: 44px minmax(0,1fr) 350px;
          gap: 26px;
        }

        .hero h1 {
          font-size: clamp(70px, 9.2vw, 132px);
        }

        .hero__poster {
          min-height: 500px;
        }

        .section-intro--split,
        .section-intro--split-dark,
        .section-intro--questions,
        .intro__head,
        .intro__body,
        .material-system__grid {
          grid-template-columns: 140px minmax(0,1fr);
        }

        .report-prompt__content {
          grid-template-columns: minmax(0,1fr) 360px;
          gap: 45px;
        }
      }

      /* RESPONSIVE 900 */
      @media (max-width: 900px) {
        .container {
          width: min(calc(100% - 34px), var(--page));
        }

        .header-inner {
          min-height: 70px;
        }

        .header-tools__place {
          display: none;
        }

        .hero {
          padding-top: 95px;
        }

        .hero__layout {
          grid-template-columns: 1fr;
          min-height: auto;
        }

        .hero__rail {
          display: none;
        }

        .hero__copy {
          min-height: 760px;
          padding: 32px 0 35px;
        }

        .hero__title {
          padding-top: 120px;
        }

        .hero__summary {
          grid-template-columns: 1fr;
        }

        .hero__cta-row {
          justify-content: flex-start;
        }

        .hero__poster {
          min-height: 390px;
          margin: 0 0 26px;
        }

        .hero__footer {
          min-height: 56px;
        }

        .hero__footer-note {
          min-height: 56px;
        }

        .intro,
        .experience,
        .method,
        .questions,
        .coverage,
        .material-system,
        .principles {
          padding-top: 112px;
          padding-bottom: 120px;
        }

        .intro__headline h2,
        .material-system__main h2,
        .report-prompt h2,
        .closing__main h2 {
          font-size: clamp(52px, 9vw, 85px);
        }

        .service-matrix {
          grid-template-columns: 1fr;
        }

        .service-card {
          min-height: 410px;
        }

        .stats-grid {
          grid-template-columns: repeat(2, 1fr);
        }

        .stat-cell:nth-child(2) {
          border-right: 0;
        }

        .stat-cell:nth-child(-n + 2) {
          border-bottom: 1px solid rgba(16,19,17,.18);
        }

        .coverage-shell,
        .footer__top,
        .report-prompt__content {
          grid-template-columns: 1fr;
        }

        .coverage-art {
          min-height: 440px;
        }

        .material-system__grid {
          grid-template-columns: 1fr;
        }

        .material-system__side {
          grid-template-columns: auto 1fr;
          align-items: start;
          gap: 24px;
        }

        .material-system__side p {
          max-width: 260px;
        }

        .material-list__row {
          grid-template-columns: 45px 1fr 68px 28px;
        }

        .material-list__row small {
          display: none;
        }

        .principles-grid {
          grid-template-columns: 1fr;
        }

        .principle-card,
        .principle-card + .principle-card {
          min-height: 300px;
          padding: 23px 0 35px;
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }

        .principle-card:last-child {
          border-bottom: 0;
        }

        .principle-glyph {
          margin-top: 38px;
        }

        .footer__links {
          grid-template-columns: repeat(3, 1fr);
        }

        .cursor {
          display: none;
        }
      }

      /* RESPONSIVE 640 */
      @media (max-width: 640px) {
        .container {
          width: calc(100% - 28px);
        }

        .brand__text small {
          display: none;
        }

        .hero {
          min-height: auto;
        }

        .hero__copy {
          min-height: 665px;
        }

        .hero__meta {
          align-items: flex-start;
        }

        .hero__meta .eyebrow:last-child {
          display: none;
        }

        .hero__title {
          padding-top: 98px;
        }

        .hero h1 {
          font-size: clamp(66px, 19vw, 105px);
          line-height: .83;
        }

        .hero__small-title {
          font-size: 10px;
        }

        .hero__summary p {
          font-size: 13px;
          line-height: 1.7;
        }

        .hero__cta-row {
          width: 100%;
        }

        .button {
          flex: 1;
          min-width: 0;
        }

        .button--quiet {
          display: none;
        }

        .hero__poster {
          min-height: 350px;
          padding: 13px;
        }

        .poster__letters {
          font-size: 78px;
        }

        .poster__shape--one {
          width: 86px;
          height: 86px;
        }

        .poster__shape--four {
          width: 110px;
          height: 110px;
        }

        .hero__footer {
          grid-template-columns: 1fr;
        }

        .hero__footer-note {
          display: none;
        }

        .intro__head,
        .intro__body,
        .section-intro--split,
        .section-intro--split-dark,
        .section-intro--questions {
          grid-template-columns: 1fr;
          gap: 24px;
        }

        .intro__body {
          margin-top: 55px;
        }

        .intro__number {
          display: none;
        }

        .lead {
          font-size: 25px;
        }

        .intro__copy-grid {
          grid-template-columns: 1fr;
          gap: 22px;
        }

        .intro__principle-strip {
          grid-template-columns: 1fr;
          gap: 9px;
        }

        .principle-strip__line {
          display: none;
        }

        .principle-strip__item {
          border-bottom: 1px solid var(--line);
          padding: 13px 0;
        }

        .principle-strip__item small {
          justify-self: start;
        }

        .section-intro h2 {
          font-size: clamp(46px, 14vw, 70px);
        }

        .service-card {
          min-height: 370px;
          padding: 16px;
        }

        .service-card__visual svg {
          width: 94%;
        }

        .service-card__body h3 {
          font-size: 28px;
        }

        .stats-grid {
          grid-template-columns: 1fr 1fr;
        }

        .stat-cell {
          min-height: 132px;
          padding: 18px 16px;
        }

        .stat-cell strong {
          font-size: 37px;
        }

        .timeline-item {
          min-height: 220px;
          grid-template-columns: 42px 1px minmax(0,1fr);
          gap: 18px;
        }

        .timeline-side {
          display: none;
        }

        .timeline-copy h3 {
          margin-top: 40px;
          font-size: 35px;
        }

        .question-row {
          min-height: 92px;
          grid-template-columns: 32px 1fr 24px;
          gap: 10px;
        }

        .question-row small {
          display: none;
        }

        .question-row strong {
          font-size: 21px;
        }

        .coverage-shell {
          background: var(--ink);
        }

        .coverage-art {
          min-height: 350px;
          padding: 15px;
        }

        .territory {
          min-height: 300px;
        }

        .territory__ring--1 { width: 190px; height: 190px; }
        .territory__ring--2 { width: 300px; height: 300px; }
        .territory__ring--3 { width: 410px; height: 410px; }

        .directory-head,
        .directory-row {
          grid-template-columns: 32px 1fr 24px;
          gap: 9px;
          padding-inline: 14px;
        }

        .directory-head span:nth-child(3),
        .directory-head span:nth-child(4),
        .directory-row > span:nth-child(3),
        .directory-row > span:nth-child(4) {
          display: none;
        }

        .directory-row strong {
          font-size: 21px;
        }

        .material-system__side {
          grid-template-columns: 1fr;
        }

        .material-system__index {
          width: 74px;
          height: 74px;
          font-size: 36px;
        }

        .material-list__row {
          grid-template-columns: 36px 1fr 44px 24px;
          min-height: 79px;
        }

        .material-list__row strong {
          font-size: 18px;
        }

        .material-list__row b {
          font-size: 7px;
        }

        .report-prompt {
          padding: 92px 0 95px;
        }

        .report-prompt__meta span:last-child {
          display: none;
        }

        .report-prompt h2 {
          font-size: 55px;
        }

        .report-prompt__content {
          gap: 38px;
        }

        .report-button {
          width: 100%;
        }

        .closing {
          min-height: 560px;
        }

        .closing__inner {
          min-height: 560px;
        }

        .closing__top span:last-child,
        .closing__bottom span:first-child {
          display: none;
        }

        .closing__main h2 {
          font-size: 65px;
        }

        .footer__top {
          padding: 60px 0 46px;
          gap: 50px;
        }

        .footer__links {
          grid-template-columns: 1fr 1fr;
          gap: 35px 20px;
        }

        .footer-col:last-child {
          grid-column: 1 / -1;
        }

        .footer__bottom {
          min-height: auto;
          padding: 18px 0 24px;
          grid-template-columns: 1fr 1fr;
          gap: 9px;
        }

        .footer__bottom span:nth-child(2) {
          text-align: right;
        }

        .footer__bottom span:last-child {
          grid-column: 1 / -1;
          text-align: left;
        }

        .floating-report {
          right: 14px;
          bottom: 14px;
          width: 52px;
          height: 52px;
          min-height: 52px;
          padding: 0;
          display: grid;
          place-items: center;
          gap: 0;
          border-radius: 1px;
        }

        .floating-report__icon {
          width: 52px;
          height: 52px;
          background: var(--green);
          color: var(--ink);
          font-size: 27px;
        }

        .floating-report__copy,
        .floating-report__arrow {
          display: none;
        }
      }

      /* REDUCED MOTION */
      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation-duration: .01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: .01ms !important;
        }
      }
