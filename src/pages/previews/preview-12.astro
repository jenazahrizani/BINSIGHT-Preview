      }

      .hero__rail-top,
      .hero__rail-bottom {
        display: grid;
        gap: 7px;
        justify-items: center;
      }

      .hero__rail-top span:first-child {
        color: var(--green);
      }

      .hero__rail-track {
        width: 1px;
        height: 160px;
        position: relative;
        background: rgba(255,255,255,.1);
        overflow: hidden;
      }

      .hero__rail-track span {
        width: 1px;
        height: 160px;
        display: block;
        background: var(--green);
        transition: height .2s ease;
      }

      .hero__copy {
        min-width: 0;
        padding: 44px 0 70px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .hero__meta {
        display: flex;
        justify-content: space-between;
        gap: 16px;
      }

      .eyebrow {
        margin: 0;
        color: var(--green);
        font: 8px/1.25 "DM Mono", monospace;
        letter-spacing: .12em;
      }

      .eyebrow.dark {
        color: var(--green-2);
      }

      .eyebrow.light {
        color: var(--green);
      }

      .hero__title-wrap {
        display: grid;
      }

      .hero__title {
        padding-top: 16vh;
      }

      .hero__small-title {
        margin: 0 0 12px;
        color: rgba(255,255,255,.42);
        font: 500 13px/1 "DM Mono", monospace;
        letter-spacing: .06em;
      }

      .hero h1 {
        max-width: 950px;
        margin: 0;
        font: 700 clamp(76px, 10.1vw, 152px)/.83 "Space Grotesk", sans-serif;
        letter-spacing: -.085em;
      }

      .hero h1 > span {
        display: block;
        animation: titleIn 1.1s var(--ease) both;
      }

      .hero h1 > span:nth-child(2) {
        color: var(--green);
        animation-delay: .08s;
      }

      .hero__title-rule {
        width: min(470px, 72%);
        height: 1px;
        margin-top: 30px;
        background: rgba(255,255,255,.14);
        position: relative;
        overflow: hidden;
      }

      .hero__title-rule::after {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 55%;
        background: var(--green);
        transform: translateX(-100%);
        animation: ruleIn 1.3s .35s var(--ease) forwards;
      }

      .hero__summary {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 40px;
        align-items: end;
      }

      .hero__summary p {
        max-width: 500px;
        margin: 0;
        color: rgba(255,255,255,.58);
        font-size: 15px;
        line-height: 1.75;
      }

      .hero__cta-row {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
        justify-content: flex-end;
      }

      .button {
        min-height: 50px;
        padding: 0 16px;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        font-size: 10px;
        font-weight: 800;
        transition: transform .25s var(--ease), background .2s ease, border-color .2s ease, color .2s ease;
      }

      .button b {
        font: 400 17px/1 "DM Mono", monospace;
      }

      .button--solid {
        background: var(--green);
        color: var(--ink);
      }

      .button--solid:hover {
        background: white;
      }

      .button--quiet {
        border: 1px solid rgba(255,255,255,.17);
        color: rgba(255,255,255,.76);
      }

      .button--quiet:hover {
        border-color: rgba(255,255,255,.42);
        color: white;
      }

      .hero__poster {
        --rx: 0deg;
        --ry: 0deg;
        position: relative;
        align-self: stretch;
        margin: 30px 0 35px;
        min-height: 560px;
        padding: 18px;
        border: 1px solid rgba(255,255,255,.14);
        background: linear-gradient(145deg, rgba(255,255,255,.06), rgba(255,255,255,.015));
        transform: perspective(1200px) rotateX(var(--rx)) rotateY(var(--ry));
        transition: transform .25s ease;
      }

      .poster__frame {
        position: absolute;
        inset: 8px;
        border: 1px solid rgba(255,255,255,.06);
        pointer-events: none;
      }

      .poster__top,
      .poster__bottom {
        position: relative;
        z-index: 3;
        display: flex;
        justify-content: space-between;
        gap: 12px;
        color: rgba(255,255,255,.4);
        font: 7px "DM Mono", monospace;
        letter-spacing: .1em;
      }

      .poster__field {
        position: absolute;
        inset: 58px 25px 55px;
        overflow: hidden;
        background:
          linear-gradient(90deg, transparent 0 24%, rgba(255,255,255,.045) 24% 24.2%, transparent 24.2% 49%, rgba(255,255,255,.045) 49% 49.2%, transparent 49.2% 74%, rgba(255,255,255,.045) 74% 74.2%, transparent 74.2%),
          linear-gradient(0deg, transparent 0 24%, rgba(255,255,255,.035) 24% 24.2%, transparent 24.2% 49%, rgba(255,255,255,.035) 49% 49.2%, transparent 49.2% 74%, rgba(255,255,255,.035) 74% 74.2%, transparent 74.2%);
      }

      .poster__vertical {
        position: absolute;
        top: 50%;
        right: -77px;
        transform: rotate(90deg);
        transform-origin: center;
        color: rgba(255,255,255,.18);
        font: 7px "DM Mono", monospace;
        letter-spacing: .12em;
        white-space: nowrap;
      }

      .poster__letters {
        position: absolute;
        left: -4px;
        top: 42%;
        display: grid;
        gap: 0;
        color: transparent;
        -webkit-text-stroke: 1px rgba(255,255,255,.26);
        font: 700 clamp(90px, 9vw, 138px)/.67 "Space Grotesk", sans-serif;
        letter-spacing: -.09em;
      }

      .poster__letters span:nth-child(2n) {
        color: rgba(255,255,255,.06);
        -webkit-text-stroke: 0;
      }

      .poster__shape {
        position: absolute;
        border-radius: 999px;
        transform-origin: center;
      }

      .poster__shape--one {
        width: 120px;
        height: 120px;
        right: 16%;
        top: 22%;
        border: 1px solid rgba(199,228,84,.6);
        animation: posterOrbit 12s linear infinite;
      }

      .poster__shape--two {
        width: 8px;
        height: 8px;
        right: 35%;
        top: 41%;
        background: var(--green);
        box-shadow: 0 0 0 9px rgba(199,228,84,.08), 0 0 22px rgba(199,228,84,.38);
        animation: pulseDot 2.5s ease-in-out infinite;
      }

      .poster__shape--three {
        width: 170px;
        height: 1px;
        right: 9%;
        top: 63%;
        background: var(--coral);
        transform: rotate(-32deg);
        animation: slashMove 5s ease-in-out infinite;
      }

      .poster__shape--four {
        width: 160px;
        height: 160px;
        left: 16%;
        bottom: 9%;
        border: 1px dashed rgba(255,255,255,.16);
        animation: spin 18s linear infinite reverse;
      }

      .hero__footer {
        position: relative;
        z-index: 3;
        min-height: 64px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        border-top: 1px solid rgba(255,255,255,.12);
        align-items: center;
      }

      .hero__ticker {
        overflow: hidden;
        white-space: nowrap;
      }

      .hero__ticker-track {
        display: inline-flex;
        align-items: center;
        gap: 16px;
        min-width: max-content;
        color: rgba(255,255,255,.55);
        font: 8px "DM Mono", monospace;
        letter-spacing: .09em;
        animation: marquee 26s linear infinite;
      }

      .hero__ticker-track i {
        color: var(--coral);
        font-style: normal;
      }

      .hero__footer-note {
        min-height: 64px;
        padding-left: 20px;
        display: flex;
        align-items: center;
        gap: 12px;
        border-left: 1px solid rgba(255,255,255,.11);
        color: rgba(255,255,255,.36);
        font: 7px "DM Mono", monospace;
        letter-spacing: .1em;
      }

      .hero__scroll-arrow {
        color: var(--green);
        font-size: 14px;
        animation: nudge 1.8s ease-in-out infinite;
      }

      /* SHARED LIGHT */
      .section-light {
        background: var(--paper);
        color: var(--ink);
      }

      .overline {
        color: #7e7b73;
        font: 8px "DM Mono", monospace;
        letter-spacing: .11em;
      }

      .overline--light {
        color: rgba(255,255,255,.3);
      }

      .section-intro {
        display: grid;
        gap: 40px;
      }

      .section-intro--split,
      .section-intro--split-dark {
        grid-template-columns: 180px minmax(0, 820px);
      }

      .section-intro--questions {
        grid-template-columns: 180px minmax(0, 1fr);
      }

      .section-intro h2 {
        max-width: 850px;
        margin: 0;
        font: 700 clamp(48px, 6vw, 82px)/.93 "Space Grotesk", sans-serif;
        letter-spacing: -.07em;
      }

      .section-intro h2 em {
        color: var(--green);
        font-style: normal;
      }

      .section-light .section-intro h2 em {
        color: var(--green-2);
      }

      .section-deck {
        max-width: 560px;
        margin: 24px 0 0;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.8;
      }

      .light-deck {
        color: rgba(255,255,255,.54);
      }

      /* INTRO */
      .intro {
        padding: 150px 0 128px;
      }

      .intro__head {
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr);
        gap: 40px;
      }

      .intro__headline h2 {
        max-width: 940px;
        margin: 16px 0 0;
        font: 700 clamp(56px, 7vw, 92px)/.92 "Space Grotesk", sans-serif;
        letter-spacing: -.075em;
      }

      .intro__headline h2 span {
        color: var(--green-2);
      }

      .intro__body {
        margin-top: 85px;
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr);
        gap: 40px;
      }

      .intro__number {
        color: #b5b0a4;
        font: 500 clamp(58px, 6vw, 84px)/.9 "DM Mono", monospace;
        letter-spacing: -.08em;
      }

      .intro__statement {
        max-width: 930px;
      }

      .lead {
        max-width: 820px;
        margin: 0;
        font: 500 clamp(26px, 3vw, 43px)/1.18 "Space Grotesk", sans-serif;
        letter-spacing: -.045em;
      }

      .intro__copy-grid {
        max-width: 790px;
        margin-top: 45px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 34px;
      }

      .intro__copy-grid p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.82;
      }

      .intro__principle-strip {
        margin-top: 90px;
        padding-top: 24px;
        display: grid;
        grid-template-columns: 1fr 1px 1fr 1px 1fr;
        align-items: center;
        border-top: 2px solid var(--ink);
      }

      .principle-strip__item {
        min-height: 54px;
        padding-right: 18px;
        display: grid;
        grid-template-columns: 34px auto 1fr;
        align-items: center;
        gap: 13px;
      }

      .principle-strip__item span {
        color: var(--green-2);
        font: 9px "DM Mono", monospace;
      }

      .principle-strip__item strong {
        font: 700 12px "DM Mono", monospace;
        letter-spacing: .03em;
      }

      .principle-strip__item small {
        color: #89857d;
        font-size: 11px;
        justify-self: end;
      }

      .principle-strip__line {
        height: 34px;
        background: var(--line);
      }

      /* EXPERIENCE */
      .experience {
        padding: 145px 0 160px;
        background: var(--ink);
        color: white;
      }

      .experience .section-intro {
        margin-bottom: 65px;
      }

      .service-matrix {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1px;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.12);
      }

      .service-card {
        position: relative;
        min-height: 485px;
        padding: 21px;
        display: grid;
        grid-template-rows: auto 1fr auto;
        background: var(--ink-2);
        overflow: hidden;
        transition: background .35s ease, transform .35s var(--ease);
      }

      .service-card::before {
        content: "";
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at var(--mx, 50%) var(--my, 50%), rgba(255,255,255,.08), transparent 28%);
        opacity: 0;
        transition: opacity .35s ease;
        pointer-events: none;
      }

      .service-card:hover::before {
        opacity: 1;
      }

      .service-card:hover {
        background: #1a201c;
      }

      .service-card__head,
      .service-card__foot {
        position: relative;
        z-index: 2;
        display: grid;
        grid-template-columns: 44px 1fr auto;
        align-items: center;
        gap: 12px;
        font: 7px "DM Mono", monospace;
        letter-spacing: .08em;
      }

      .service-card__head > span {
        color: var(--green);
      }

      .service-card__head small {
        color: rgba(255,255,255,.38);
      }

      .service-card__head b,
      .service-card__foot span:last-child {
        justify-self: end;
        font-weight: 400;
        color: rgba(255,255,255,.4);
      }

      .service-card__visual {
        position: relative;
        display: grid;
        place-items: center;
        overflow: hidden;
      }

      .service-card__visual::after {
        content: "";
        position: absolute;
        width: 170px;
        height: 170px;
        border: 1px solid rgba(255,255,255,.05);
        border-radius: 50%;
      }

      .service-card__visual svg {
        width: 82%;
        max-width: 310px;
        height: auto;
        overflow: visible;
        transition: transform .6s var(--ease);
      }

      .service-card:hover .service-card__visual svg {
        transform: scale(1.05) rotate(-1deg);
      }

      .icon-stroke {
        fill: none;
        stroke: rgba(255,255,255,.28);
        stroke-width: 1.25;
        vector-effect: non-scaling-stroke;
      }

      .icon-stroke--major {
        stroke: rgba(255,255,255,.65);
        stroke-width: 1.5;
      }

      .icon-stroke--soft {
        stroke: rgba(255,255,255,.11);
      }

      .icon-stroke--accent {
        stroke: var(--green);
        stroke-width: 2;
      }

      .icon-node {
        fill: var(--green);
        stroke: var(--ink-2);
        stroke-width: 2;
        transform-box: fill-box;
        transform-origin: center;
        animation: nodeBlink 3s ease-in-out infinite;
      }

      .icon-node--accent {
        fill: var(--coral);
      }

      .network-node {
        fill: var(--ink-2);
        stroke: rgba(255,255,255,.45);
        stroke-width: 1.3;
        vector-effect: non-scaling-stroke;
      }

      .network-node--accent {
        fill: var(--green);
        stroke: var(--green);
      }

      .material-block {
        fill: rgba(255,255,255,.05);
        stroke: rgba(255,255,255,.36);
        stroke-width: 1;
        vector-effect: non-scaling-stroke;
        transform-box: fill-box;
        transform-origin: center;
      }

      .material-block--b {
        fill: rgba(228,109,80,.08);
        stroke: var(--coral);
      }

      .material-block--c {
        fill: rgba(199,228,84,.08);
        stroke: var(--green);
      }

      .service-card__body {
        position: relative;
        z-index: 2;
        max-width: 520px;
        padding: 20px 0 32px;
      }

      .service-card__body h3 {
        margin: 0;
        font: 700 clamp(28px, 3vw, 40px)/1 "Space Grotesk", sans-serif;
        letter-spacing: -.055em;
      }

      .service-card__body p {
        max-width: 430px;
        margin: 16px 0 0;
        color: rgba(255,255,255,.48);
        font-size: 13px;
        line-height: 1.72;
      }

      .service-card__foot {
        padding-top: 15px;
        grid-template-columns: 1fr auto;
        border-top: 1px solid rgba(255,255,255,.1);
        color: rgba(255,255,255,.36);
      }

      .service-card__foot span:first-child {
        color: rgba(255,255,255,.55);
      }

      /* STATS */
      .stats-band {
        background: var(--green);
        color: var(--ink);
      }

      .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
      }

      .stat-cell {
        min-height: 160px;
        padding: 25px 24px;
        display: grid;
        align-content: center;
        gap: 6px;
        border-right: 1px solid rgba(16,19,17,.18);
      }

      .stat-cell:last-child {
        border-right: 0;
      }

      .stat-cell strong {
        font: 700 clamp(34px, 4vw, 56px)/.9 "Space Grotesk", sans-serif;
        letter-spacing: -.07em;
      }

      .stat-cell span {
        font: 700 8px "DM Mono", monospace;
        letter-spacing: .1em;
      }

      .stat-cell small {
        color: rgba(16,19,17,.56);
        font-size: 10px;
      }

      /* METHOD */
      .method {
        padding: 145px 0 155px;
      }

      .method .section-intro {
        margin-bottom: 78px;
      }

      .method-timeline {
        border-top: 2px solid var(--ink);
      }

      .timeline-item {
        min-height: 245px;
        display: grid;
        grid-template-columns: 92px 1px minmax(0, 1fr) 130px;
        gap: 26px;
        align-items: stretch;
        border-bottom: 1px solid var(--line);
        position: relative;
        transition: background .3s ease;
      }

      .timeline-item:hover {
        background: rgba(16,19,17,.035);
      }

      .timeline-marker {
        padding-top: 24px;
        color: var(--green-2);
        font: 10px "DM Mono", monospace;
      }

      .timeline-line {
        width: 1px;
        background: var(--line);
      }

      .timeline-copy {
        padding: 27px 0 35px;
      }

      .timeline-copy small {
        color: #8a867d;
        font: 7px "DM Mono", monospace;
        letter-spacing: .1em;
      }

      .timeline-copy h3 {
        margin: 52px 0 13px;
        font: 700 clamp(32px, 4vw, 50px)/.93 "Space Grotesk", sans-serif;
        letter-spacing: -.055em;
      }

      .timeline-copy p {
        max-width: 520px;
        margin: 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.76;
      }

      .timeline-side {
        align-self: end;
        padding-bottom: 31px;
        color: #8a867d;
        font: 8px "DM Mono", monospace;
        letter-spacing: .1em;
        text-align: right;
      }

      /* QUESTIONS */
      .questions {
        padding: 142px 0 155px;
        background: var(--ink-2);
        color: white;
      }

      .question-list {
        margin-top: 62px;
        border-top: 1px solid rgba(255,255,255,.16);
      }

      .question-row {
        min-height: 110px;
        display: grid;
        grid-template-columns: 70px minmax(0,1fr) 150px 38px;
        align-items: center;
        gap: 18px;
        border-bottom: 1px solid rgba(255,255,255,.1);
        transition: padding .35s var(--ease), background .25s ease;
      }

      .question-row:hover {
        padding-inline: 18px;
        background: rgba(255,255,255,.035);
      }

      .question-row__no {
        color: rgba(255,255,255,.3);
        font: 9px "DM Mono", monospace;
      }

      .question-row strong {
        font: 600 clamp(22px, 3vw, 34px)/1 "Space Grotesk", sans-serif;
        letter-spacing: -.045em;
      }

      .question-row small,
      .question-row__arrow {
        color: rgba(255,255,255,.34);
        font: 8px "DM Mono", monospace;
        letter-spacing: .07em;
      }

      .question-row__arrow {
        justify-self: end;
        color: var(--green);
        font-size: 16px;
      }

      /* COVERAGE */
      .coverage {
        padding: 145px 0 160px;
      }

      .coverage .section-intro {
        margin-bottom: 75px;
      }

      .coverage-shell {
        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(360px, .95fr);
        gap: 1px;
        background: var(--ink);
        border: 1px solid var(--ink);
      }

      .coverage-art {
        min-height: 530px;
        padding: 20px;
        display: grid;
        grid-template-rows: auto 1fr auto;
        background: var(--ink-2);
        color: white;
      }

      .coverage-art__header,
      .coverage-art__footer {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        color: rgba(255,255,255,.38);
        font: 7px "DM Mono", monospace;
        letter-spacing: .08em;
      }

      .territory {
        position: relative;
        min-height: 410px;
        overflow: hidden;
      }

      .territory__ring {
        position: absolute;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 50%;
        transform: translate(-50%, -50%);
      }

      .territory__ring--1 {
        width: 270px;
        height: 270px;
        left: 48%;
        top: 50%;
        animation: pulseRing 5s ease-in-out infinite;
      }

      .territory__ring--2 {
        width: 410px;
        height: 410px;
        left: 48%;
        top: 50%;
      }

      .territory__ring--3 {
        width: 560px;
        height: 560px;
        left: 48%;
        top: 50%;
        border-style: dashed;
        animation: spin 28s linear infinite;
      }

      .territory__path {
        position: absolute;
        height: 1px;
        background: rgba(255,255,255,.2);
        transform-origin: left center;
      }

      .territory__path--1 {
        width: 330px;
        left: 28%;
        top: 34%;
        transform: rotate(16deg);
      }

      .territory__path--2 {
        width: 290px;
        left: 38%;
        top: 58%;
        transform: rotate(-31deg);
      }

      .territory__path--3 {
        width: 260px;
        left: 24%;
        top: 71%;
        transform: rotate(12deg);
      }

      .territory__dot {
        position: absolute;
        width: 33px;
        height: 33px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(255,255,255,.55);
        border-radius: 50%;
        background: var(--ink-2);
        color: white;
        font: 8px "DM Mono", monospace;
        transition: transform .25s ease, background .25s ease, color .25s ease;
      }

      .territory__dot:hover {
        transform: scale(1.18);
        background: var(--green);
        color: var(--ink);
      }

      .territory__dot--1 { left: 31%; top: 28%; }
      .territory__dot--2 { left: 61%; top: 52%; }
      .territory__dot--3 { left: 44%; top: 70%; }

      .territory__label {
        position: absolute;
        color: rgba(255,255,255,.32);
        font: 7px "DM Mono", monospace;
        letter-spacing: .08em;
      }

      .territory__label--1 { left: 25%; top: 20%; }
      .territory__label--2 { left: 66%; top: 45%; }
      .territory__label--3 { left: 38%; top: 77%; }

      .area-directory {
        background: var(--white);
        color: var(--ink);
      }

      .directory-head,
      .directory-row {
        display: grid;
        grid-template-columns: 44px minmax(0,1fr) 110px 95px;
        gap: 14px;
        align-items: center;
      }

      .directory-head {
        min-height: 50px;
        padding: 0 22px;
        border-bottom: 1px solid var(--line);
        color: #88847c;
        font: 7px "DM Mono", monospace;
        letter-spacing: .08em;
      }

      .directory-row {
        min-height: 110px;
        padding: 0 22px;
        border-bottom: 1px solid var(--line);
        transition: background .25s ease, padding .25s var(--ease);
      }

      .directory-row:hover {
        padding-left: 30px;
        background: var(--paper);
      }

      .directory-row > span:first-child,
      .directory-row > span:nth-child(3),
      .directory-row > span:last-child {
        color: #8b877f;
        font: 8px "DM Mono", monospace;
      }

      .directory-row strong {
        display: block;
        font: 600 25px/1 "Space Grotesk", sans-serif;
        letter-spacing: -.04em;
      }

      .directory-row small {
        display: block;
        margin-top: 7px;
        color: #969189;
        font: 7px "DM Mono", monospace;
        letter-spacing: .05em;
      }

      .directory-row .state {
        color: var(--green-2);
      }

      .directory-more {
        min-height: 72px;
        padding: 0 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font: 8px "DM Mono", monospace;
        letter-spacing: .08em;
      }

      .directory-more span:last-child {
        color: var(--coral);
        font-size: 15px;
      }

      /* MATERIAL */
      .material-system {
        padding: 145px 0 160px;
        background: var(--ink);
        color: white;
      }

      .material-system__grid {
        display: grid;
        grid-template-columns: 180px minmax(0,1fr);
        gap: 40px;
      }

      .material-system__side {
        display: grid;
        align-content: start;
        gap: 95px;
      }

      .material-system__index {
        width: 92px;
        height: 92px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(255,255,255,.15);
        color: var(--green);
        font: 700 44px/1 "Space Grotesk", sans-serif;
      }

      .material-system__side p {
        max-width: 160px;
        margin: 0;
        color: rgba(255,255,255,.4);
        font-size: 11px;
        line-height: 1.7;
      }

      .material-system__main h2 {
        max-width: 760px;
        margin: 16px 0 0;
        font: 700 clamp(52px, 6.5vw, 86px)/.91 "Space Grotesk", sans-serif;
        letter-spacing: -.075em;
      }

      .material-system__main h2 em {
        color: var(--green);
        font-style: normal;
      }

      .material-list {
        margin-top: 68px;
        border-top: 1px solid rgba(255,255,255,.15);
      }

      .material-list__row {
        min-height: 92px;
        display: grid;
        grid-template-columns: 50px minmax(190px, .65fr) minmax(200px, 1fr) 70px 30px;
        gap: 15px;
        align-items: center;
        border-bottom: 1px solid rgba(255,255,255,.1);
        transition: background .25s ease, padding .3s var(--ease);
      }

      .material-list__row:hover {
        padding-inline: 15px;
        background: rgba(255,255,255,.035);
      }

      .material-list__row > span,
      .material-list__row small,
      .material-list__row b,
      .material-list__row i {
        font: 8px "DM Mono", monospace;
        color: rgba(255,255,255,.34);
        letter-spacing: .05em;
      }

      .material-list__row strong {
        font: 600 21px "Space Grotesk", sans-serif;
        letter-spacing: -.03em;
      }

      .material-list__row b {
        color: var(--green);
        text-align: right;
      }

      .material-list__row i {
        justify-self: end;
        color: var(--coral);
        font-style: normal;
        font-size: 15px;
      }

      /* PRINCIPLES */
      .principles {
        padding: 145px 0 155px;
      }

      .principles .section-intro {
        margin-bottom: 74px;
      }

      .principles-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        border-top: 2px solid var(--ink);
      }

      .principle-card {
        min-height: 420px;
        padding: 23px 28px 34px 0;
        border-right: 1px solid var(--line);
        transition: background .3s ease, padding .3s var(--ease);
      }

      .principle-card + .principle-card {
        padding-left: 28px;
      }

      .principle-card:last-child {
        border-right: 0;
      }

      .principle-card:hover {
        background: rgba(16,19,17,.025);
      }

      .principle-card__top {
        display: flex;
        justify-content: space-between;
        color: #8a867d;
        font: 8px "DM Mono", monospace;
      }

      .principle-card__top span:first-child {
        color: var(--green-2);
      }

      .principle-glyph {
        position: relative;
        height: 115px;
        margin-top: 55px;
        overflow: hidden;
      }

      .principle-glyph span {
        position: absolute;
        display: block;
      }

      .principle-glyph--1 span:nth-child(1) {
        width: 74px;
        height: 74px;
        left: 4%;
        top: 20%;
        border: 1px solid var(--ink);
        border-radius: 50%;
        animation: glyphFloat 5s ease-in-out infinite;
      }

      .principle-glyph--1 span:nth-child(2) {
        width: 44px;
        height: 44px;
        left: 24%;
        top: 0;
        background: var(--green);
        border-radius: 50%;
        mix-blend-mode: multiply;
      }

      .principle-glyph--1 span:nth-child(3) {
        width: 190px;
        height: 1px;
        left: 2%;
        top: 65%;
        background: var(--ink);
        transform: rotate(-8deg);
      }

      .principle-glyph--2 span:nth-child(1),
      .principle-glyph--2 span:nth-child(2),
      .principle-glyph--2 span:nth-child(3),
      .principle-glyph--2 span:nth-child(4) {
        width: 16px;
        height: 16px;
        border: 1px solid var(--ink);
        border-radius: 50%;
        animation: pulseDot 2.4s ease-in-out infinite;
      }

      .principle-glyph--2 span:nth-child(1) { left: 10%; top: 45%; }
      .principle-glyph--2 span:nth-child(2) { left: 31%; top: 18%; background: var(--green); }
      .principle-glyph--2 span:nth-child(3) { left: 50%; top: 57%; }
      .principle-glyph--2 span:nth-child(4) { left: 74%; top: 28%; }

      .principle-glyph--2::before,
      .principle-glyph--2::after {
        content: "";
        position: absolute;
        height: 1px;
        background: var(--ink);
        transform-origin: left;
      }

      .principle-glyph--2::before {
        width: 160px;
        left: 15%;
        top: 48%;
        transform: rotate(-25deg);
      }

      .principle-glyph--2::after {
        width: 130px;
        left: 31%;
        top: 50%;
        transform: rotate(18deg);
      }

      .principle-glyph--3 span:nth-child(1) {
        width: 112px;
        height: 58px;
        left: 4%;
        top: 20%;
        border: 1px solid var(--ink);
        border-radius: 60px 60px 0 0;
        transform: rotate(-20deg);
      }

      .principle-glyph--3 span:nth-child(2) {
        width: 75px;
        height: 75px;
        left: 39%;
        top: 0;
        border-radius: 50%;
        background: var(--coral);
        opacity: .9;
      }

      .principle-glyph--3 span:nth-child(3) {
        width: 1px;
        height: 110px;
        left: 70%;
        top: 0;
        background: var(--ink);
        transform: rotate(18deg);
      }

      .principle-card h3 {
        margin: 35px 0 13px;
        font: 700 31px/1 "Space Grotesk", sans-serif;
        letter-spacing: -.05em;
      }

      .principle-card p {
        max-width: 340px;
        margin: 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.75;
      }

      /* REPORT */
      .report-prompt {
        padding: 118px 0 130px;
        background: var(--coral);
        color: white;
      }

      .report-prompt__inner {
        display: grid;
        gap: 58px;
      }

      .report-prompt__meta {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        font: 8px "DM Mono", monospace;
        letter-spacing: .1em;
        color: rgba(255,255,255,.56);
      }

      .report-prompt__content {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(290px, .44fr);
        gap: 70px;
        align-items: end;
      }

      .report-prompt h2 {
        margin: 14px 0 0;
        font: 700 clamp(55px, 7vw, 96px)/.88 "Space Grotesk", sans-serif;
        letter-spacing: -.075em;
      }

      .report-prompt h2 em {
        color: var(--ink);
        font-style: normal;
      }

      .report-prompt__action p {
        max-width: 400px;
        margin: 0 0 25px;
        color: rgba(255,255,255,.66);
        font-size: 13px;
        line-height: 1.75;
      }

      .report-button {
        min-height: 58px;
        padding: 0 18px;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 25px;
        border: 1px solid rgba(16,19,17,.28);
        background: var(--ink);
        color: white;
        font-size: 11px;
        font-weight: 800;
        transition: transform .25s var(--ease), background .2s ease;
      }

      .report-button:hover {
        background: white;
        color: var(--ink);
      }

      .report-button b {
        font: 400 18px "DM Mono", monospace;
      }

      /* CLOSING */
      .closing {
        position: relative;
        min-height: 690px;
        display: flex;
        align-items: stretch;
        overflow: hidden;
        background: var(--paper-2);
      }

      .closing__giant {
        position: absolute;
        left: -2vw;
        bottom: 2%;
        font: 800 clamp(180px, 31vw, 520px)/.63 "Space Grotesk", sans-serif;
        letter-spacing: -.12em;
        color: rgba(16,19,17,.06);
        white-space: nowrap;
        user-select: none;
        animation: closingDrift 20s ease-in-out infinite alternate;
      }

      .closing__inner {
        position: relative;
        z-index: 2;
        min-height: 690px;
        padding: 35px 0 42px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .closing__top,
      .closing__bottom {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        color: #77736b;
        font: 8px "DM Mono", monospace;
        letter-spacing: .09em;
      }

      .closing__main h2 {
        margin: 15px 0 48px;
        font: 700 clamp(68px, 10vw, 142px)/.8 "Space Grotesk", sans-serif;
        letter-spacing: -.09em;
      }

      .closing__main h2 span {
        color: var(--green-2);
      }

      .closing-link {
        min-height: 56px;
        padding: 0 18px;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 35px;
        background: var(--ink);
        color: white;
        font-size: 11px;
        font-weight: 800;
        transition: transform .25s var(--ease), background .2s ease;
      }

      .closing-link:hover {
        background: var(--green);
        color: var(--ink);
      }

      .closing-link b {
        font: 400 17px "DM Mono", monospace;
      }

      /* FOOTER */
      .footer {
        background: var(--ink);
        color: white;
      }

      .footer__top {
        padding: 80px 0 70px;
        display: grid;
        grid-template-columns: minmax(0,1fr) minmax(420px,1fr);
        gap: 80px;
      }

      .brand--footer .brand__glyph i:first-child {
        background: white;
      }

      .brand--footer .brand__glyph i:nth-child(2) {
        background: var(--green);
      }

      .brand--footer .brand__glyph i:nth-child(3) {
        background: var(--coral);
      }

      .footer__brand-block > p {
        max-width: 330px;
        margin: 24px 0 0;
        color: rgba(255,255,255,.4);
        font-size: 13px;
        line-height: 1.75;
      }

      .footer__links {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 30px;
      }

      .footer-col {
        display: grid;
        align-content: start;
        gap: 10px;
      }

      .footer-col > span {
        margin-bottom: 8px;
        color: rgba(255,255,255,.25);
        font: 7px "DM Mono", monospace;
        letter-spacing: .09em;
      }

      .footer-col a,
      .footer-col strong {
        color: rgba(255,255,255,.67);
        font-size: 12px;
        font-weight: 500;
      }

      .footer-col a:hover {
        color: white;
      }

      .footer-col small {
        color: rgba(255,255,255,.34);
        font: 7px/1.6 "DM Mono", monospace;
        letter-spacing: .04em;
      }

      .footer__bottom {
        min-height: 66px;
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        align-items: center;
        border-top: 1px solid rgba(255,255,255,.1);
        color: rgba(255,255,255,.24);
        font: 7px "DM Mono", monospace;
        letter-spacing: .07em;
      }

      .footer__bottom span:nth-child(2) {
        text-align: center;
      }

      .footer__bottom span:last-child {
        text-align: right;
      }

      /* FLOATING REPORT */
      .floating-report {
        position: fixed;
        right: 24px;
        bottom: 20px;
        z-index: 280;
        min-height: 58px;
        padding: 7px 10px 7px 9px;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: var(--green);
        color: var(--ink);
        box-shadow: 0 14px 38px rgba(16,19,17,.22);
        transition: transform .25s var(--ease), box-shadow .25s ease;
      }

      .floating-report:hover {
        transform: translateY(-4px);
        box-shadow: 0 20px 48px rgba(16,19,17,.3);
      }

      .floating-report__icon {
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        background: var(--ink);
        color: var(--green);
        font: 400 23px/1 "DM Mono", monospace;
      }

      .floating-report__copy {
        display: grid;
        gap: 4px;
      }

      .floating-report__copy small {
        font: 7px "DM Mono", monospace;
        letter-spacing: .08em;
      }

      .floating-report__copy strong {
        font: 800 11px/1 "Inter", sans-serif;
      }

      .floating-report__arrow {
        font: 400 17px "DM Mono", monospace;
      }

      /* CURSOR */
      .cursor {
        position: fixed;
        left: 0;
        top: 0;
        z-index: 600;
        pointer-events: none;
        border-radius: 50%;
        transform: translate(-50%,-50%);
        display: block;
      }

      .cursor--outer {
        width: 28px;
        height: 28px;
        border: 1px solid rgba(199,228,84,.65);
        transition: width .25s ease, height .25s ease, border-color .25s ease;
      }

      .cursor--inner {
        width: 4px;
        height: 4px;
        background: var(--green);
      }

      .cursor-focus .cursor--outer {
        width: 52px;
        height: 52px;
        border-color: rgba(199,228,84,.9);
      }

      /* REVEALS */
      [data-reveal-section] > .container,
      [data-reveal-section] .section-intro,
      [data-reveal-section] .service-matrix,
      [data-reveal-section] .stats-grid,
      [data-reveal-section] .method-timeline,
      [data-reveal-section] .question-list,
      [data-reveal-section] .coverage-shell,
      [data-reveal-section] .material-system__grid,
      [data-reveal-section] .principles-grid,
      [data-reveal-section] .report-prompt__inner,
      [data-reveal-section] .closing__inner {
        opacity: 0;
        transform: translateY(45px);
        transition: opacity .9s var(--ease), transform .9s var(--ease);
      }

      [data-reveal-section].is-visible > .container,
      [data-reveal-section].is-visible .section-intro,
      [data-reveal-section].is-visible .service-matrix,
      [data-reveal-section].is-visible .stats-grid,
      [data-reveal-section].is-visible .method-timeline,
      [data-reveal-section].is-visible .question-list,
      [data-reveal-section].is-visible .coverage-shell,
      [data-reveal-section].is-visible .material-system__grid,
      [data-reveal-section].is-visible .principles-grid,
      [data-reveal-section].is-visible .report-prompt__inner,
      [data-reveal-section].is-visible .closing__inner {
        opacity: 1;
        transform: translateY(0);
      }

      .service-card:nth-child(2),
      .service-card:nth-child(4),
      .principle-card:nth-child(2) {
        transition-delay: .08s;
      }

      .service-card:nth-child(3),
      .principle-card:nth-child(3) {
        transition-delay: .14s;
      }

      /* KEYFRAMES */
      @keyframes navIn {
        from { transform: scaleX(0); }
        to { transform: scaleX(1); }
      }

      @keyframes titleIn {
        from { opacity: 0; transform: translateY(42px); clip-path: inset(100% 0 0 0); }
        to { opacity: 1; transform: translateY(0); clip-path: inset(0 0 0 0); }
      }

      @keyframes ruleIn {
        to { transform: translateX(0); }
      }

      @keyframes posterDrift {
        from { transform: translate3d(0,0,0) rotate(-4deg); }
        to { transform: translate3d(-2vw,2vh,0) rotate(1deg); }
      }

      @keyframes posterDriftReverse {
        from { transform: translate3d(0,0,0) rotate(3deg); }
        to { transform: translate3d(1.4vw,-1.5vh,0) rotate(-1deg); }
      }

      @keyframes posterOrbit {
        from { transform: rotate(0deg) scale(1); }
        50% { transform: rotate(180deg) scale(1.08); }
        to { transform: rotate(360deg) scale(1); }
      }

      @keyframes pulseDot {
        0%,100% { transform: scale(1); opacity: .7; }
        50% { transform: scale(1.25); opacity: 1; }
      }

      @keyframes slashMove {
        0%,100% { transform: rotate(-32deg) translateX(0); opacity: .35; }
        50% { transform: rotate(-32deg) translateX(-22px); opacity: 1; }
      }

      @keyframes spin {
        to { transform: translate(-50%,-50%) rotate(360deg); }
      }

      @keyframes pulseRing {
        0%,100% { transform: translate(-50%,-50%) scale(.95); opacity: .5; }
        50% { transform: translate(-50%,-50%) scale(1.05); opacity: 1; }
      }

      @keyframes nodeBlink {
        0%,100% { opacity: .55; }
        50% { opacity: 1; }
      }

      @keyframes glyphFloat {
        0%,100% { transform: translate3d(0,0,0); }
        50% { transform: translate3d(10px,-5px,0); }
      }

      @keyframes marquee {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
      }

      @keyframes nudge {
        0%,100% { transform: translateY(0); }
        50% { transform: translateY(5px); }
      }

      @keyframes closingDrift {
        from { transform: translateX(0); }
        to { transform: translateX(-3vw); }
      }


