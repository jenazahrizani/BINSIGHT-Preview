/* PRINCIPLES --------------------------------------------- */
.principles {
  padding: 132px 0;
  background: var(--white);
  border-bottom: 1px solid var(--line);
}
.principles__head {
  display: grid;
  grid-template-columns: 180px minmax(0,1fr);
  gap: 48px;
  margin-bottom: 64px;
}
.principles__head .label {
  margin: 0 0 18px;
  color: var(--forest);
  font-size: 8px;
  letter-spacing: .1em;
}
.principles h2 {
  margin: 0;
  font-size: clamp(50px,6vw,81px);
  line-height: .92;
  letter-spacing: -.07em;
}
.principles h2 em {
  color: var(--forest);
  font-family: "Playfair Display", serif;
  font-weight: 500;
}
.principles__list {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  border-top: 1px solid var(--ink);
}
.principle-card {
  min-height: 340px;
  padding: 24px 30px 34px 0;
  border-right: 1px solid var(--line);
}
.principle-card + .principle-card {
  padding-left: 28px;
}
.principle-card:last-child {
  border-right: 0;
}
.principle-card__top {
  display: flex;
  justify-content: space-between;
  color: #8b877f;
  font-size: 8px;
}
.principle-card__top span:first-child {
  color: var(--coral);
}
.principle-card__visual {
  height: 70px;
  margin-top: 50px;
  position: relative;
}
.principle-card__visual span {
  position: absolute;
  border: 1px solid var(--forest);
}
.principle-card__visual span:nth-child(1) {
  width: 62px;
  height: 62px;
  left: 0;
  top: 0;
  border-radius: 50%;
}
.principle-card__visual span:nth-child(2) {
  width: 42px;
  height: 42px;
  left: 31px;
  top: 15px;
  background: var(--coral);
  border-color: var(--coral);
  mix-blend-mode: multiply;
}
.principle-card__visual span:nth-child(3) {
  width: 20px;
  height: 20px;
  left: 68px;
  top: 26px;
  background: var(--forest);
  border-color: var(--forest);
}
.principle-card:nth-child(2) .principle-card__visual span:nth-child(1) {
  border-radius: 0;
  transform: rotate(45deg);
}
.principle-card:nth-child(2) .principle-card__visual span:nth-child(2) {
  left: 52px;
}
.principle-card:nth-child(2) .principle-card__visual span:nth-child(3) {
  left: 83px;
}
.principle-card:nth-child(3) .principle-card__visual span:nth-child(1) {
  width: 70px;
  height: 48px;
  border-radius: 0;
}
.principle-card:nth-child(3) .principle-card__visual span:nth-child(2) {
  left: 36px;
  top: 24px;
}
.principle-card:nth-child(3) .principle-card__visual span:nth-child(3) {
  left: 76px;
  top: 7px;
}
.principle-card h3 {
  margin: 42px 0 0;
  font-size: 28px;
  line-height: 1;
  letter-spacing: -.04em;
}
.principle-card p {
  max-width: 300px;
  margin: 14px 0 0;
  color: var(--muted);
  font-size: 12.5px;
  line-height: 1.75;
}
/* CLOSING ------------------------------------------------- */
.closing {
