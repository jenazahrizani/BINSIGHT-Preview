/* FLOATING REPORT ---------------------------------------- */
.floating-report {
  position: fixed;
  right: 18px;
  bottom: 18px;
  z-index: 95;
  min-width: 205px;
  min-height: 64px;
  padding: 10px 12px;
  display: grid;
  grid-template-columns: 34px 1fr auto;
  align-items: center;
  gap: 10px;
  background: var(--ink);
  color: #fff;
  box-shadow: 0 13px 35px rgba(0,0,0,.16);
  transition: transform .25s var(--ease), background .2s ease;
}
.floating-report:hover {
  transform: translateY(-3px);
  background: var(--forest);
}
.floating-report__icon {
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255,255,255,.25);
  color: var(--coral-soft);
  font-size: 20px;
  font-weight: 300;
}
.floating-report__copy {
  display: grid;
  gap: 4px;
}
.floating-report small {
  color: rgba(255,255,255,.4);
  font-size: 6px;
  letter-spacing: .07em;
}
.floating-report strong {
  font-size: 10px;
  letter-spacing: .01em;
}
.floating-report__arrow {
  color: var(--coral);
  font-size: 17px;
}

.floating-report:focus-visible {
  outline: 2px solid var(--coral);
  outline-offset: 3px;
}
