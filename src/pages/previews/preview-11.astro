  margin: 0 0 17px;
  color: var(--forest);
  font-size: 8px;
  letter-spacing: .1em;
}
.section-head h2 {
  max-width: 820px;
  margin: 0;
  font-size: clamp(50px,6vw,81px);
  line-height: .93;
  letter-spacing: -.07em;
}
.section-head h2 em {
  color: var(--coral);
  font-family: "Playfair Display", serif;
  font-weight: 500;
}
.section-description {
  max-width: 560px;
  margin: 24px 0 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.8;
}
.module-grid {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 1px;
  background: var(--line);
  border-top: 1px solid var(--line);
}
.module-card {
  min-height: 520px;
  padding: 24px;
  display: grid;
  grid-template-rows: auto 180px 1fr auto;
  gap: 20px;
  position: relative;
  background: var(--white);
  overflow: hidden;
  transition: transform .3s var(--ease), background .3s ease;
}
.module-card:hover {
  z-index: 1;
  transform: translateY(-4px);
}
.module-card--forest:hover {
  background: #f7faf7;
}
.module-card--coral:hover {
  background: #fff8f5;
}
.module-card--ink:hover {
  background: #f7f7f6;
}
.module-card--stone:hover {
  background: #faf8f3;
}
.module-card__head {
  display: grid;
  grid-template-columns: 40px 1fr auto;
  gap: 12px;
  align-items: center;
  font-size: 8px;
}
.module-card__no {
  color: #8b877f;
}
.module-card__kicker {
  color: var(--muted);
  letter-spacing: .06em;
}
.module-card__arrow {
  color: var(--coral);
  font-size: 18px;
  transition: transform .2s ease;
}
.module-card:hover .module-card__arrow {
  transform: translate(3px,-3px);
}
.module-card__visual {
  position: relative;
  overflow: hidden;
  border-top: 1px solid var(--ink);
  border-bottom: 1px solid var(--line);
  background: var(--paper-2);
}
.module-card--forest .module-card__visual {
  background: var(--forest);
}
.module-card--coral .module-card__visual {
  background: var(--coral);
}
.module-card--ink .module-card__visual {
  background: var(--ink);
}
.visual-map-grid {
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(0deg,transparent 0 21px,rgba(255,255,255,.08) 21px 22px),repeating-linear-gradient(90deg,transparent 0 21px,rgba(255,255,255,.08) 21px 22px);
}
.visual-map-route {
  position: absolute;
  height: 2px;
  background: rgba(255,255,255,.75);
  transform-origin: left;
}
.visual-map-route--one {
  width: 70%;
  left: 12%;
  top: 47%;
  transform: rotate(-21deg);
}
.visual-map-route--two {
  width: 62%;
  left: 26%;
  top: 69%;
  transform: rotate(28deg);
}
.visual-pin {
  position: absolute;
  width: 11px;
  height: 11px;
  border: 2px solid var(--coral);
  background: #fff;
  border-radius: 50%;
}
.visual-pin--one {
  left: 24%;
  top: 39%;
}
.visual-pin--two {
  left: 58%;
  top: 47%;
}
.visual-pin--three {
  left: 75%;
  top: 64%;
}
.visual-data-axis {
  position: absolute;
  left: 38px;
  right: 24px;
  bottom: 28px;
  height: 1px;
  background: rgba(255,255,255,.52);
}
.visual-data-bars {
  position: absolute;
  inset: 24px 30px 28px 40px;
  display: flex;
  align-items: end;
  gap: 10px;
}
.visual-data-bars i {
  display: block;
  flex: 1;
  background: rgba(255,255,255,.9);
}
.visual-data-label {
  position: absolute;
  right: 26px;
  top: 22px;
  color: rgba(255,255,255,.6);
  font: 7px "DM Mono", monospace;
  letter-spacing: .08em;
}
.visual-network-line {
  position: absolute;
  height: 1px;
  background: rgba(255,255,255,.4);
  transform-origin: left;
}
.line-a {
  width: 53%;
  left: 23%;
  top: 42%;
  transform: rotate(10deg);
}
.line-b {
  width: 44%;
  left: 36%;
  top: 58%;
  transform: rotate(-27deg);
}
.line-c {
  width: 35%;
  left: 31%;
  top: 58%;
  transform: rotate(55deg);
}
.visual-network-node {
  position: absolute;
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(255,255,255,.8);
  color: #fff;
  font: 11px "DM Mono", monospace;
  background: var(--ink);
}
.node-a {
  left: 18%;
  top: 33%;
}
.node-b {
  left: 51%;
  top: 22%;
}
.node-c {
  left: 72%;
  top: 50%;
}
.node-d {
  left: 41%;
  top: 61%;
}
.material-shape {
  position: absolute;
  display: block;
  border: 1px solid rgba(23,23,21,.28);
  background: rgba(255,255,255,.35);
}
.material-shape--a {
  width: 120px;
  height: 120px;
  border-radius: 50%;
  left: 11%;
  top: 20%;
}
.material-shape--b {
  width: 76px;
  height: 76px;
  right: 18%;
  top: 13%;
  transform: rotate(14deg);
}
.material-shape--c {
  width: 112px;
  height: 62px;
  right: 8%;
  bottom: 10%;
  transform: rotate(-19deg);
}
.material-shape--d {
  width: 52px;
  height: 52px;
  left: 43%;
  bottom: 18%;
  border-radius: 50%;
}
.module-card__body {
  align-self: start;
}
.module-card__body h3 {
  margin: 0;
  font-size: 31px;
  line-height: 1;
  letter-spacing: -.045em;
}
.module-card__body p {
  max-width: 430px;
  margin: 14px 0 0;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.74;
}
.module-card__foot {
  padding-top: 18px;
  border-top: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  gap: 12px;
  color: #858178;
  font-size: 7px;
  letter-spacing: .08em;
}
.module-card__foot span:last-child {
  color: var(--ink);
}
/* METHOD -------------------------------------------------- */
.method {
  padding: 132px 0 0;
  background: var(--forest);
  color: #fff;
}
.method__top {
  display: grid;
  grid-template-columns: 180px minmax(0,1fr);
  gap: 48px;
  padding-bottom: 72px;
}
.section-label--light span {
  color: var(--coral-soft);
}
.section-label--light small, .label--light {
  color: rgba(255,255,255,.45) !important;
}
.method h2 {
  margin: 0;
  font-size: clamp(50px,6vw,80px);
  line-height: .93;
  letter-spacing: -.068em;
}
.method h2 em {
  display: block;
  color: var(--coral-soft);
  font-family: "Playfair Display", serif;
  font-weight: 500;
}
.method__steps {
  display: grid;
  grid-template-columns: repeat(3,minmax(0,1fr));
  border-top: 1px solid rgba(255,255,255,.14);
}
.method__steps article {
  min-height: 355px;
  padding: 25px 28px 30px;
  position: relative;
  border-right: 1px solid rgba(255,255,255,.11);
}
.method__steps article:last-child {
  border-right: 0;
}
.step-top {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  color: rgba(255,255,255,.43);
  font-size: 8px;
  letter-spacing: .08em;
}
.step-number {
  margin-top: 63px;
  color: rgba(255,255,255,.11);
  font: 800 84px/1 "Manrope", sans-serif;
  letter-spacing: -.08em;
}
.method h3 {
  margin: -3px 0 0;
  font-size: 33px;
  letter-spacing: -.045em;
}
.method__steps p {
  max-width: 300px;
  margin: 14px 0 0;
  color: rgba(255,255,255,.53);
  font-size: 13px;
  line-height: 1.75;
}
.step-rule {
  position: absolute;
  left: 28px;
  bottom: 0;
  width: 48px;
  height: 2px;
  background: var(--coral);
}
/* SIGNALS ------------------------------------------------- */
.signals {
  padding: 132px 0;
  background: var(--white);
  border-bottom: 1px solid var(--line);
}
.signals__head {
  display: grid;
  grid-template-columns: 180px minmax(0,1fr);
  gap: 48px;
  margin-bottom: 62px;
}
.signals__head .label {
  margin: 0 0 17px;
  color: var(--forest);
  font-size: 8px;
  letter-spacing: .1em;
}
.signals h2 {
  margin: 0;
  font-size: clamp(50px,6vw,81px);
  line-height: .93;
  letter-spacing: -.07em;
}
.signals h2 em {
  color: var(--forest);
  font-family: "Playfair Display", serif;
  font-weight: 500;
}
.signals__table {
  border-top: 1px solid var(--ink);
}
.signal-row {
  min-height: 115px;
  display: grid;
  grid-template-columns: 62px 70px 230px minmax(0,1fr) 36px;
  align-items: center;
  gap: 20px;
  border-bottom: 1px solid var(--line);
  transition: background .2s ease, padding .2s ease;
}
.signal-row:hover {
  padding-inline: 12px;
  background: var(--paper);
}
.signal-code {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  background: var(--forest);
  color: #fff;
  font-size: 10px;
}
.signal-index {
  color: #8b877f;
  font-size: 8px;
}
.signal-row strong {
  font: 700 18px "DM Mono", monospace;
  letter-spacing: .05em;
}
.signal-row p {
  max-width: 500px;
  margin: 0;
  color: var(--muted);
  font: 400 12px/1.75 "Manrope", sans-serif;
}
.signal-arrow {
  justify-self: end;
  color: var(--coral);
  font: 18px "Manrope", sans-serif;
}
.signals__formula {
  margin-top: 56px;
  padding: 22px 0 0;
  border-top: 2px solid var(--coral);
  display: grid;
  gap: 9px;
}
.signals__formula span {
  color: #8a867e;
  font-size: 7px;
  letter-spacing: .09em;
}
.signals__formula strong {
  color: var(--forest);
  font-size: clamp(12px,1.7vw,18px);
  letter-spacing: .04em;
}
/* COVERAGE ------------------------------------------------ */
.coverage {
  padding: 132px 0;
  background: var(--paper);
  border-bottom: 1px solid var(--line);
}
.coverage__head {
  display: grid;
  grid-template-columns: 180px minmax(0,1fr);
  gap: 48px;
  margin-bottom: 60px;
}
.coverage__head .label {
  margin: 0 0 17px;
  color: var(--forest);
  font-size: 8px;
  letter-spacing: .1em;
}
.coverage h2 {
  margin: 0;
  font-size: clamp(50px,6vw,81px);
  line-height: .93;
  letter-spacing: -.07em;
}
.coverage h2 em {
  display: block;
  color: var(--forest);
  font-family: "Playfair Display", serif;
  font-weight: 500;
}
.coverage__layout {
  display: grid;
  grid-template-columns: 1.08fr .92fr;
  gap: 1px;
  background: var(--line);
}
.coverage__map {
  min-height: 520px;
  padding: 18px;
  background: var(--forest);
  color: #fff;
  display: flex;
  flex-direction: column;
}
.coverage-map__top, .coverage-map__bottom {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  font-size: 7px;
  color: rgba(255,255,255,.47);
  letter-spacing: .08em;
}
.coverage-map__art {
  position: relative;
  flex: 1;
  margin: 16px 0;
  overflow: hidden;
  background: linear-gradient(rgba(255,255,255,.02),rgba(255,255,255,.02));
}
.coverage-grid {
  position: absolute;
  inset: 0;
  background: repeating-linear-gradient(0deg,transparent 0 29px,rgba(255,255,255,.05) 29px 30px), repeating-linear-gradient(90deg,transparent 0 29px,rgba(255,255,255,.05) 29px 30px);
}
.land {
  position: absolute;
  border: 1px solid rgba(255,255,255,.7);
  background: rgba(255,255,255,.08);
  transform-origin: center;
}
.land--a {
  width: 235px;
  height: 315px;
  left: 29%;
  top: 10%;
  transform: rotate(17deg) skewY(-5deg);
}
.land--b {
  width: 160px;
  height: 100px;
  left: 48%;
  top: 43%;
  transform: rotate(-14deg);
}
.land--c {
  width: 105px;
  height: 120px;
  left: 23%;
  top: 57%;
  transform: rotate(10deg);
}
.coverage-pin {
  position: absolute;
  padding: 5px 7px;
  border: 1px solid rgba(255,255,255,.6);
  background: var(--coral);
  color: #fff;
  font: 7px "DM Mono", monospace;
  letter-spacing: .05em;
}
.coverage-pin--badung {
  left: 43%;
  top: 23%;
}
.coverage-pin--mengwi {
  left: 61%;
  top: 51%;
}
.coverage-pin--abian {
  left: 23%;
  top: 67%;
}
.coverage-coord {
  position: absolute;
  color: rgba(255,255,255,.31);
  font: 7px "DM Mono", monospace;
  letter-spacing: .06em;
}
.coverage-coord--one {
  left: 12px;
  top: 12px;
}
.coverage-coord--two {
  right: 12px;
  bottom: 12px;
}
.area-list {
  background: var(--white);
}
.area-list__head, .area-row {
  display: grid;
  grid-template-columns: 54px minmax(0,1fr) 120px 95px;
  align-items: center;
  gap: 14px;
}
.area-list__head {
  min-height: 48px;
  padding-inline: 23px;
  border-bottom: 1px solid var(--line);
  color: #8a867e;
  font-size: 7px;
  letter-spacing: .08em;
}
.area-row {
  min-height: 122px;
  padding-inline: 23px;
  border-bottom: 1px solid var(--line);
  transition: background .2s ease;
}
.area-row:hover {
  background: var(--paper);
}
.area-row > span {
  font-size: 8px;
  color: #89857d;
}
.area-row strong {
  display: block;
  font-size: 20px;
  letter-spacing: -.03em;
}
.area-row small {
  display: block;
  margin-top: 6px;
  color: var(--muted);
  font-size: 9px;
}
.area-status {
  color: var(--forest) !important;
  letter-spacing: .04em;
}
.area-more {
  min-height: 65px;
  padding-inline: 23px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  color: var(--ink);
  font: 7px "DM Mono", monospace;
  letter-spacing: .08em;
}
.area-more span:last-child {
  color: var(--coral);
}
/* MATERIALS ---------------------------------------------- */
.materials {
  padding: 132px 0;
  background: var(--paper-2);
  border-bottom: 1px solid var(--line);
}
.materials__grid {
  display: grid;
  grid-template-columns: 180px minmax(0,1fr);
  gap: 48px;
}
.materials__content {
  display: grid;
  grid-template-columns: minmax(0,.76fr) minmax(0,1.24fr);
  gap: 76px;
}
.materials__intro .label {
  margin: 0 0 18px;
  color: var(--forest);
  font-size: 8px;
  letter-spacing: .1em;
}
.materials__intro h2 {
  margin: 0;
  font-size: clamp(50px,6vw,81px);
  line-height: .92;
  letter-spacing: -.07em;
}
.materials__intro h2 em {
  color: var(--coral);
  font-family: "Playfair Display", serif;
  font-weight: 500;
}
.materials__copy {
  max-width: 420px;
  margin: 25px 0 0;
  color: var(--muted);
  font-size: 14px;
  line-height: 1.8;
}
.materials__link {
  margin-top: 31px;
  display: inline-flex;
  gap: 12px;
  align-items: center;
  color: var(--forest);
  font-size: 8px;
  font-weight: 500;
  letter-spacing: .06em;
}
.materials__link span:last-child {
  color: var(--coral);
  font: 16px "Manrope", sans-serif;
}
.materials__list {
  border-top: 1px solid var(--ink);
}
.material-row {
  min-height: 105px;
  display: grid;
  grid-template-columns: 42px minmax(150px,.75fr) minmax(140px,1.2fr) 54px 22px;
  align-items: center;
  gap: 16px;
  border-bottom: 1px solid rgba(21,21,21,.17);
  transition: padding .2s ease, background .2s ease;
}
.material-row:hover {
  padding-inline: 10px;
  background: rgba(255,255,255,.45);
}
.material-row__no {
  color: #8b877f;
  font-size: 8px;
}
.material-row strong {
  font-size: 18px;
  letter-spacing: -.02em;
}
.material-row__desc {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.55;
}
.material-row small {
  color: var(--forest);
  font-size: 8px;
  text-align: right;
}
.material-row__arrow {
  justify-self: end;
  color: var(--coral);
  font-size: 17px;
}
/* INFORMATION LAYERS ----------------------------------- */
.layers {
  padding: 132px 0;
  background: var(--white);
  border-bottom: 1px solid var(--line);
}
.layers__head,       .pathway__head {
  display: grid;
  grid-template-columns: 180px minmax(0,1fr);
  gap: 48px;
  margin-bottom: 60px;
}
.layers__head .label,       .pathway__head .label {
  margin: 0 0 18px;
  color: var(--forest);
  font-size: 8px;
  letter-spacing: .1em;
}
.layers h2,       .pathway h2 {
  margin: 0;
  font-size: clamp(50px,6vw,81px);
  line-height: .93;
  letter-spacing: -.07em;
}
.layers h2 em,       .pathway h2 em {
  color: var(--forest);
  font-family: "Playfair Display", serif;
  font-weight: 500;
}
.layers__board {
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 1px;
  background: var(--line);
  border-top: 1px solid var(--line);
}
.layer-card {
  min-height: 360px;
  padding: 25px 27px 25px;
  display: flex;
  flex-direction: column;
  background: var(--paper);
  position: relative;
}
.layer-card--dark {
  background: var(--ink);
  color: #fff;
}
.layer-card--coral {
  background: var(--coral);
  color: #fff;
}
.layer-card__index {
  color: #8b877f;
  font: 8px "DM Mono", monospace;
}
.layer-card--dark .layer-card__index,       .layer-card--coral .layer-card__index {
  color: rgba(255,255,255,.55);
}
.layer-card small {
  margin-top: 10px;
  color: #87837b;
  font: 7px "DM Mono", monospace;
  letter-spacing: .08em;
}
.layer-card--dark small,       .layer-card--coral small {
  color: rgba(255,255,255,.47);
}
.layer-card strong {
  margin-top: auto;
  font-size: clamp(38px,5vw,65px);
  line-height: .9;
  letter-spacing: -.07em;
}
.layer-card p {
  max-width: 370px;
  margin: 15px 0 0;
  color: var(--muted);
  font-size: 12.5px;
  line-height: 1.75;
}
.layer-card--dark p,       .layer-card--coral p {
  color: rgba(255,255,255,.63);
}
.layer-card__rule {
  width: 45px;
  height: 2px;
  margin-top: 32px;
  background: var(--coral);
}
.layer-card--coral .layer-card__rule {
  background: #fff;
}
.layer-card a {
  margin-top: 17px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  color: var(--ink);
  font: 8px "DM Mono", monospace;
  letter-spacing: .07em;
}
.layer-card--dark a,       .layer-card--coral a {
  color: #fff;
}
.layer-card a span {
  color: var(--coral);
  font: 17px "Manrope", sans-serif;
}
.layer-card--coral a span {
  color: #fff;
}
.layers__note {
  min-height: 74px;
  padding-top: 19px;
  display: grid;
  grid-template-columns: 180px minmax(0,1fr);
  gap: 48px;
  align-items: start;
  border-bottom: 1px solid var(--line);
}
.layers__note span {
  color: #89857d;
  font: 7px "DM Mono", monospace;
  letter-spacing: .09em;
}
.layers__note strong {
  color: var(--forest);
  font: 700 10px "DM Mono", monospace;
  letter-spacing: .06em;
}
/* PUBLIC PATHWAY ---------------------------------------- */
.pathway {
  padding: 132px 0;
  background: var(--paper);
  border-bottom: 1px solid var(--line);
}
.pathway__rows {
  border-top: 1px solid var(--ink);
}
.pathway-row {
  min-height: 108px;
  display: grid;
  grid-template-columns: 70px minmax(0,1fr) 180px;
  gap: 25px;
  align-items: center;
  border-bottom: 1px solid var(--line);
  transition: padding .2s ease, background .2s ease;
}
.pathway-row:hover {
  padding-inline: 12px;
  background: var(--paper-2);
}
.pathway-row__no {
  color: #8b877f;
  font-size: 8px;
}
.pathway-row strong {
  font-size: 20px;
  letter-spacing: -.03em;
}
.pathway-row__route {
  justify-self: end;
  color: var(--forest);
  font: 8px "DM Mono", monospace;
  letter-spacing: .07em;
}
@media (max-width: 940px) {
  .layers__head,         .pathway__head {
    grid-template-columns: 110px minmax(0,1fr);
    gap: 28px;
  }
}
@media (max-width: 720px) {
  .layers,         .pathway {
