
---
const base = import.meta.env.BASE_URL;
const url = (path = '') => `${base}${path.replace(/^\/+/, '')}`;

const services = [
  {
    title: 'Peta Persampahan',
    desc: 'Jelajahi informasi persampahan berdasarkan lokasi dan wilayah.',
    href: 'map',
    icon: 'map-pinned',
  },
  {
    title: 'Data & Informasi',
    desc: 'Lihat data dan informasi untuk memahami kondisi persampahan.',
    href: 'dashboard',
    icon: 'chart-no-axes-combined',
  },
  {
    title: 'Organisasi',
    desc: 'Kenali pihak dan unsur yang terlibat dalam pengelolaan sampah.',
    href: 'organizations',
    icon: 'building-2',
  },
  {
    title: 'Pengetahuan Material',
    desc: 'Pelajari karakteristik dan cara pengelolaan berbagai jenis sampah.',
    href: 'waste',
    icon: 'layers-3',
  },
];

const explorations = [
  {
    title: 'Jenis Sampah',
    desc: 'Pelajari kategori dan pengelolaan sampah.',
    href: 'waste',
    icon: 'recycle',
  },
  {
    title: 'Laporan Masyarakat',
    desc: 'Pantau dan kirim laporan persampahan.',
    href: 'reports',
    icon: 'message-square-text',
  },
  {
    title: 'Tentang BINSIGHT',
    desc: 'Kenali platform dan tujuan BINSIGHT.',
    href: 'company',
    icon: 'info',
  },
];

const principles = [
  {
    title: 'Kontekstual',
    body: 'Informasi disajikan dengan memperhatikan kondisi dan karakter wilayah Badung.',
  },
  {
    title: 'Terbuka',
    body: 'Data dan pengetahuan persampahan perlu mudah ditemukan serta dipahami.',
  },
  {
    title: 'Bertanggung jawab',
    body: 'Informasi yang baik membantu mendorong keputusan dan tindakan yang lebih bijak.',
  },
];

const materials = [
  {
    name: 'Organik',
    desc: 'Sisa makanan, dedaunan, dan material hayati yang dapat terurai.',
    icon: 'sprout',
  },
  {
    name: 'Anorganik',
    desc: 'Kertas, plastik, kaca, dan logam yang perlu dipilah.',
    icon: 'package',
  },
  {
    name: 'Bahan berbahaya',
    desc: 'Material yang membutuhkan penanganan secara khusus.',
    icon: 'triangle-alert',
  },
  {
    name: 'Elektronik',
    desc: 'Perangkat dan komponen elektronik yang sudah tidak digunakan.',
    icon: 'monitor',
  },
  {
    name: 'Residu',
    desc: 'Sisa material yang tidak dapat dimanfaatkan melalui pemilahan umum.',
    icon: 'trash-2',
  },
];
---

<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#102c24" />
    <meta
      name="description"
      content="BINSIGHT — Badung Waste Intelligence. Ruang informasi persampahan Kabupaten Badung."
    />
    <title>BINSIGHT — Badung Waste Intelligence</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={url()} aria-label="BINSIGHT Beranda">
          <span>BINSIGHT</span>
        </a>

        <button
          class="mobile-toggle"
          type="button"
          aria-label="Buka navigasi"
          aria-expanded="false"
          aria-controls="main-navigation"
        >
          <img
            class="toggle-open"
            src="https://api.iconify.design/lucide/menu.svg?color=%23ffffff"
            alt=""
          />
          <img
            class="toggle-close"
            src="https://api.iconify.design/lucide/x.svg?color=%23ffffff"
            alt=""
          />
        </button>

        <nav class="main-navigation" id="main-navigation" aria-label="Navigasi utama">
          <a class="nav-link active" href={url()}>Beranda</a>
          <a class="nav-link" href={url('map')}>Peta</a>
          <a class="nav-link" href={url('dashboard')}>Data</a>
          <a class="nav-link" href={url('organizations')}>Organisasi</a>

          <div class="explore-menu">
            <button
              class="explore-trigger"
              type="button"
              aria-expanded="false"
              aria-controls="explore-dropdown"
            >
              Eksplorasi
              <img
                src="https://api.iconify.design/lucide/chevron-down.svg?color=%23d9e85b"
                alt=""
              />
            </button>

            <div class="explore-dropdown" id="explore-dropdown">
              <div class="dropdown-heading">
                <span>JELAJAHI BINSIGHT</span>
                <p>Informasi lain untuk memahami pengelolaan persampahan.</p>
              </div>

              <div class="dropdown-links">
                {explorations.map((item) => (
                  <a class="dropdown-item" href={url(item.href)}>
                    <span class="dropdown-icon">
                      <img
                        src={`https://api.iconify.design/lucide/${item.icon}.svg?color=%23285b46`}
                        alt=""
                        loading="lazy"
                      />
                    </span>
                    <span class="dropdown-copy">
                      <strong>{item.title}</strong>
                      <small>{item.desc}</small>
                    </span>
                    <img
                      class="dropdown-arrow"
                      src="https://api.iconify.design/lucide/arrow-up-right.svg?color=%2368736b"
                      alt=""
                    />
                  </a>
                ))}
              </div>
            </div>
          </div>

          <a class="sign-in-link" href={url('auth/sign-in')}>
            Sign In
            <img
              src="https://api.iconify.design/lucide/arrow-up-right.svg?color=%23d9e85b"
              alt=""
            />
          </a>
        </nav>
      </div>
    </header>

    <main>
      <!-- HERO -->
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-grid" aria-hidden="true"></div>

        <svg
          class="hero-art"
          viewBox="0 0 900 700"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <defs>
            <linearGradient id="art-gradient" x1="150" y1="100" x2="750" y2="600">
              <stop stop-color="#D9E85B" />
              <stop offset="1" stop-color="#8EB69B" />
            </linearGradient>
            <radialGradient id="art-glow">
              <stop stop-color="#D9E85B" stop-opacity=".25" />
              <stop offset="1" stop-color="#D9E85B" stop-opacity="0" />
            </radialGradient>
          </defs>

          <circle cx="470" cy="340" r="260" fill="url(#art-glow)" />

          <g class="art-orbit">
            <ellipse
              cx="470" cy="340" rx="315" ry="155"
              transform="rotate(-28 470 340)"
              stroke="#D9E85B" stroke-opacity=".35"
            />
            <ellipse
              cx="470" cy="340" rx="245" ry="280"
              transform="rotate(35 470 340)"
              stroke="#D9E85B" stroke-opacity=".25"
            />
            <ellipse
              cx="470" cy="340" rx="180" ry="320"
              transform="rotate(70 470 340)"
              stroke="white" stroke-opacity=".17"
            />
          </g>

          <g class="art-network">
            <path
              d="M105 490L205 410L275 440L355 320L435 350L510 230L590 260L690 150L790 190"
              stroke="url(#art-gradient)"
              stroke-width="2"
              stroke-dasharray="5 10"
            />
            <path
              d="M160 220L260 275L340 230L430 300L520 250L620 325L750 280"
              stroke="white"
              stroke-opacity=".32"
              stroke-width="1.5"
              stroke-dasharray="3 9"
            />
            <path
              d="M145 590L260 520L360 555L460 470L570 510L700 420"
              stroke="white"
              stroke-opacity=".25"
              stroke-width="1.5"
              stroke-dasharray="3 9"
            />
          </g>

          <g class="art-points" fill="#D9E85B">
            <circle cx="205" cy="410" r="5" />
            <circle cx="355" cy="320" r="5" />
            <circle cx="510" cy="230" r="6" />
            <circle cx="690" cy="150" r="5" />
            <circle cx="790" cy="190" r="4" />
          </g>

          <g class="art-center">
            <circle cx="510" cy="230" r="23" stroke="#D9E85B" stroke-opacity=".65" />
            <circle cx="510" cy="230" r="43" stroke="#D9E85B" stroke-opacity=".3" />
            <circle cx="510" cy="230" r="65" stroke="#D9E85B" stroke-opacity=".15" />
            <circle cx="510" cy="230" r="5" fill="#D9E85B" />
          </g>

          <g stroke="white" stroke-opacity=".25">
            <path d="M510 165V110M575 230H645M510 295V350M445 230H375" />
          </g>
        </svg>

        <div class="hero-content">
          <div class="hero-eyebrow">
            <span class="status-dot"></span>
            <span>RUANG INFORMASI PERSAMPAHAN KABUPATEN BADUNG</span>
          </div>

          <h1 id="hero-title">
            Mengenali sampah,
            <em>memahami</em> Badung.
          </h1>

          <div class="hero-description">
            <p>
              Satu ruang untuk menjelajahi informasi persampahan, memahami
              kondisi wilayah, dan menemukan pengetahuan yang membantu kita
              bertindak lebih bijak.
            </p>
          </div>
        </div>

        <div class="hero-bottom-line" aria-hidden="true">
          <span>KABUPATEN BADUNG · BALI</span>
          <span>INFORMASI PERSAMPAHAN</span>
        </div>
      </section>

      <!-- INTRODUCTION -->
      <section class="intro shell" id="tentang">
        <div class="intro-aside">
          <span class="section-label">TENTANG BINSIGHT</span>
          <p>Badung Waste Intelligence</p>
        </div>

        <div class="intro-content">
          <h2>
            Informasi yang membuat persoalan
            <span>terasa lebih dekat.</span>
          </h2>

          <p>
            BINSIGHT menghadirkan informasi persampahan Kabupaten Badung dalam
            satu ruang yang mudah dijelajahi. Mulai dari lokasi, data, pelaku,
            hingga karakter material—semuanya disusun untuk membantu publik
            melihat persoalan secara lebih utuh.
          </p>
        </div>
      </section>

      <!-- SERVICES -->
      <section class="services" id="layanan">
        <div class="shell">
          <div class="section-heading">
            <div>
              <span class="section-label">JELAJAHI PLATFORM</span>
              <h2>Temukan sudut<br />pandangmu.</h2>
            </div>
            <p>
              Jelajahi informasi persampahan Badung melalui berbagai sudut
              pandang yang saling melengkapi.
            </p>
          </div>

          <div class="service-list">
            {services.map((item) => (
              <a class="service-row" href={url(item.href)}>
                <span class="service-icon">
                  <img
                    src={`https://api.iconify.design/lucide/${item.icon}.svg?color=%23285b46`}
                    alt=""
                    loading="lazy"
                  />
                </span>
                <span class="service-copy">
                  <strong>{item.title}</strong>
                  <small>{item.desc}</small>
                </span>
                <span class="service-arrow">
                  <img
                    src="https://api.iconify.design/lucide/arrow-up-right.svg?color=%23102c24"
                    alt=""
                  />
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- PRINCIPLES -->
      <section class="field-note">
        <div class="shell field-inner">
          <div class="field-heading">
            <span class="section-label">CARA KAMI MELIHAT</span>
            <h2>
              Data punya konteks.
              <span>Konteks punya arti.</span>
            </h2>
            <p>
              Informasi persampahan bukan hanya angka. Ia berkaitan dengan
              tempat, kebiasaan, material, dan orang-orang yang terlibat
              di dalamnya.
            </p>
          </div>

          <div class="principle-list">
            {principles.map((item) => (
              <article class="principle">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <!-- MATERIALS -->
      <section class="materials" id="material">
        <div class="shell">
          <div class="section-heading materials-heading">
            <div>
              <span class="section-label">KENALI MATERIAL</span>
              <h2>Kenali sebelum<br />mengelola.</h2>
            </div>
            <p>
              Setiap material memiliki karakter dan kebutuhan penanganan
              berbeda. Memahaminya adalah langkah awal untuk memilah dengan
              tepat.
            </p>
          </div>

          <div class="material-grid">
            {materials.map((item) => (
              <a class="material-card" href={url('waste')}>
                <span class="material-icon">
                  <img
                    src={`https://api.iconify.design/lucide/${item.icon}.svg?color=%23285b46`}
                    alt=""
                    loading="lazy"
                  />
                </span>

                <div class="material-copy">
                  <h3>{item.name}</h3>
                  <p>{item.desc}</p>
                </div>

                <span class="material-link">
                  Pelajari
                  <img
                    src="https://api.iconify.design/lucide/arrow-up-right.svg?color=%23285b46"
                    alt=""
                  />
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <!-- CLOSING -->
      <section class="closing">
        <div class="shell closing-inner">
          <div>
            <span class="section-label">LANGKAH BERIKUTNYA</span>
            <h2>
              Kenali. Pahami.
              <span>Jaga Badung.</span>
            </h2>
          </div>

          <a class="button-dark" href={url('map')}>
            Mulai menjelajah
            <img
              src="https://api.iconify.design/lucide/arrow-up-right.svg?color=%23ffffff"
              alt=""
            />
          </a>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="site-footer">
      <div class="shell">
        <div class="footer-main">
          <div class="footer-brand">
            <a class="brand footer-logo" href={url()}>
              <span>BINSIGHT</span>
            </a>

            <p>
              Ruang informasi persampahan Kabupaten Badung untuk mengenali
              kondisi, memahami konteks, dan mendorong tindakan yang lebih
              bertanggung jawab.
            </p>
          </div>

          <div class="footer-column">
            <span class="footer-label">NAVIGASI</span>
            <a href={url()}>Beranda</a>
            <a href={url('map')}>Peta</a>
            <a href={url('dashboard')}>Data</a>
            <a href={url('organizations')}>Organisasi</a>
          </div>

          <div class="footer-column">
            <span class="footer-label">EKSPLORASI</span>
            <a href={url('waste')}>Jenis Sampah</a>
            <a href={url('reports')}>Laporan Masyarakat</a>
            <a href={url('company')}>Tentang BINSIGHT</a>
            <a href={url('auth/sign-in')}>Sign In</a>
          </div>
        </div>

        <div class="footer-bottom">
          <p>© {new Date().getFullYear()} BINSIGHT — BADUNG WASTE INTELLIGENCE</p>
          <p>KABUPATEN BADUNG · BALI</p>
        </div>
      </div>
    </footer>

    <!-- FLOATING REPORT BUTTON -->
    <a
      class="report-button"
      href={url('reports/create')}
      aria-label="Buat laporan masyarakat"
      title="Buat laporan masyarakat"
    >
      <img
        src="https://api.iconify.design/lucide/message-square-plus.svg?color=%23102c24"
        alt=""
      />
      <span>Buat laporan</span>
    </a>

    <script>
      const menuToggle = document.querySelector('.mobile-toggle');
      const navigation = document.querySelector('.main-navigation');
      const exploreTrigger = document.querySelector('.explore-trigger');
      const exploreMenu = document.querySelector('.explore-menu');

      function closeNavigation() {
        navigation?.classList.remove('is-open');
        document.body.classList.remove('menu-open');
        menuToggle?.setAttribute('aria-expanded', 'false');
      }

      menuToggle?.addEventListener('click', () => {
        const isOpen = navigation?.classList.toggle('is-open');
        menuToggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
        document.body.classList.toggle('menu-open', Boolean(isOpen));
      });

      exploreTrigger?.addEventListener('click', () => {
        const isOpen = exploreMenu?.classList.toggle('is-expanded');
        exploreTrigger.setAttribute('aria-expanded', String(Boolean(isOpen)));
      });

      navigation?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', closeNavigation);
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          closeNavigation();
          exploreMenu?.classList.remove('is-expanded');
          exploreTrigger?.setAttribute('aria-expanded', 'false');
        }
      });

      window.addEventListener('resize', () => {
        if (window.innerWidth > 900) {
          closeNavigation();
          exploreMenu?.classList.remove('is-expanded');
          exploreTrigger?.setAttribute('aria-expanded', 'false');
        }
      });
    </script>
  </body>
</html>

<style>
  :root {
    --forest: #102c24;
    --forest-2: #183d31;
    --forest-3: #285b46;
    --lime: #d9e85b;
    --paper: #f3f2e9;
    --paper-2: #e9e9dc;
    --ink: #17231e;
    --muted: #58665e;
    --line: rgba(23, 35, 30, .16);
    --white: #fffef8;
    --mono: 'DM Mono', monospace;
    --sans: 'DM Sans', sans-serif;
    --display: 'Manrope', sans-serif;
    --gutter: clamp(20px, 5vw, 80px);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 90px;
    overflow-x: clip;
  }

  body {
    margin: 0;
    width: 100%;
    min-width: 320px;
    overflow-x: clip;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--sans);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  body.menu-open {
    overflow: hidden;
  }

  img {
    display: block;
    max-width: 100%;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font: inherit;
  }

  p,
  h1,
  h2,
  h3 {
    overflow-wrap: break-word;
    word-break: normal;
  }

  ::selection {
    background: var(--lime);
    color: var(--forest);
  }

  .shell {
    width: min(100%, 1600px);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .section-label {
    display: inline-block;
    color: var(--forest-3);
    font: 500 10px/1.7 var(--mono);
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  /* HEADER */

  .site-header {
    position: absolute;
    z-index: 50;
    inset: 0 0 auto;
    min-height: 78px;
    color: var(--white);
    border-bottom: 1px solid rgba(255, 255, 255, .16);
  }

  .header-inner {
    width: min(100%, 1600px);
    min-height: 78px;
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* Brand hanya berupa tulisan BINSIGHT */
  .brand {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    color: var(--white);
  }

  .brand span {
    font: 800 21px/1 var(--display);
    letter-spacing: -.065em;
  }

  .main-navigation {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(13px, 2vw, 30px);
    min-height: 78px;
  }

  .nav-link,
  .explore-trigger {
    color: rgba(255, 255, 255, .86);
    font: 500 13px/1.5 var(--sans);
    white-space: nowrap;
    transition: color .2s;
  }

  .nav-link:hover,
  .nav-link.active,
  .explore-trigger:hover {
    color: var(--lime);
  }

  .explore-menu {
    min-height: 78px;
    display: flex;
    align-items: center;
    position: relative;
  }

  .explore-trigger {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 12px 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .explore-trigger img {
    width: 15px;
    height: 15px;
    filter: brightness(0) saturate(100%) invert(91%) sepia(70%) saturate(520%) hue-rotate(15deg);
    transition: transform .2s;
  }

  .explore-menu:hover .explore-trigger img,
  .explore-menu.is-expanded .explore-trigger img {
    transform: rotate(180deg);
  }

  .explore-dropdown {
    position: absolute;
    top: 100%;
    right: -100px;
    width: min(390px, calc(100vw - 40px));
    padding: 22px;
    background: var(--white);
    color: var(--ink);
    border: 1px solid rgba(23, 35, 30, .1);
    box-shadow: 0 18px 50px rgba(0, 0, 0, .17);
    opacity: 0;
    visibility: hidden;
    transform: translateY(9px);
    transition: opacity .22s, transform .22s, visibility .22s;
  }

  .explore-menu:hover .explore-dropdown,
  .explore-menu:focus-within .explore-dropdown,
  .explore-menu.is-expanded .explore-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-heading {
    padding: 0 2px 17px;
    border-bottom: 1px solid var(--line);
  }

  .dropdown-heading > span {
    color: var(--forest-3);
    font: 500 9px var(--mono);
    letter-spacing: .12em;
  }

  .dropdown-heading p {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
    margin: 8px 0 0;
  }

  .dropdown-links {
    display: grid;
  }

  .dropdown-item {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr) 16px;
    align-items: center;
    gap: 12px;
    padding: 15px 2px;
    border-bottom: 1px solid rgba(23, 35, 30, .09);
  }

  .dropdown-item:last-child {
    border-bottom: 0;
    padding-bottom: 2px;
  }

  .dropdown-icon,
  .service-icon {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    background: #eef0e5;
    border-radius: 50%;
  }

  .dropdown-icon img,
  .service-icon img {
    width: 19px;
    height: 19px;
  }

  .dropdown-copy {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .dropdown-copy strong {
    font-size: 13px;
    line-height: 1.5;
    font-weight: 700;
  }

  .dropdown-copy small {
    font-size: 11px;
    line-height: 1.6;
    color: var(--muted);
  }

  .dropdown-arrow {
    width: 15px;
    height: 15px;
    opacity: .65;
  }

  .dropdown-item:hover .dropdown-copy strong {
    color: var(--forest-3);
  }

  .sign-in-link {
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 10px 15px;
    border: 1px solid rgba(217, 232, 91, .7);
    color: var(--lime);
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
    transition: background .2s, color .2s;
  }

  .sign-in-link:hover {
    background: var(--lime);
    color: var(--forest);
  }

  .sign-in-link img {
    width: 15px;
    height: 15px;
    filter: brightness(0) saturate(100%) invert(91%) sepia(70%) saturate(520%) hue-rotate(15deg);
  }

  .sign-in-link:hover img {
    filter: none;
  }

  .mobile-toggle {
    display: none;
  }

  /* HERO */

  .hero {
    min-height: 760px;
    min-height: max(700px, 100svh);
    padding: 150px var(--gutter) 100px;
    display: flex;
    align-items: center;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--forest);
    color: var(--white);
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgba(16, 44, 36, .94),
      rgba(16, 44, 36, .76) 55%,
      rgba(16, 44, 36, .65)
    );
  }

  .hero-grid {
    position: absolute;
    inset: 0 0 0 43%;
    z-index: 0;
    opacity: .13;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255, 255, 255, .18) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .18) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(90deg, transparent, black 30%);
  }

  .hero-art {
    position: absolute;
    z-index: 1;
    pointer-events: none;
    width: min(85vw, 1050px);
    height: auto;
    left: 58%;
    top: 49%;
    transform: translate(-50%, -50%);
    opacity: .36;
  }

  .art-orbit {
    transform-origin: 470px 340px;
    animation: orbit-turn 65s linear infinite;
  }

  .art-network {
    animation: network-float 9s ease-in-out infinite alternate;
  }

  .art-points {
    animation: point-glow 4s ease-in-out infinite alternate;
  }

  .art-center {
    transform-origin: 510px 230px;
    animation: center-pulse 5s ease-in-out infinite;
  }

  @keyframes orbit-turn {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes network-float {
    from { transform: translateY(0); }
    to { transform: translateY(-9px); }
  }

  @keyframes point-glow {
    from { opacity: .65; }
    to { opacity: 1; }
  }

  @keyframes center-pulse {
    0%, 100% { transform: scale(1); opacity: .75; }
    50% { transform: scale(1.09); opacity: 1; }
  }

  .hero-content {
    position: relative;
    z-index: 3;
    width: min(1120px, 100%);
    margin-inline: auto;
    min-width: 0;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--lime);
    font: 400 10px/1.8 var(--mono);
    letter-spacing: .08em;
    margin-bottom: 30px;
  }

  .status-dot {
    flex: 0 0 7px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 0 5px rgba(217, 232, 91, .12);
  }

  .hero h1 {
    max-width: 950px;
    margin: 0;
    font: 700 clamp(48px, 7vw, 100px)/1.13 var(--display);
    letter-spacing: -.055em;
    text-wrap: balance;
  }

  /* Mencegah kata memahami terbelah di layar kecil */
  .hero h1 em {
    color: var(--lime);
    font-style: normal;
    white-space: nowrap;
    display: inline-block;
  }

  .hero-description {
    max-width: 470px;
    margin-top: 34px;
  }

  .hero-description p {
    margin: 0;
    color: rgba(255, 255, 255, .84);
    font-size: 15px;
    line-height: 1.9;
    text-wrap: pretty;
  }

  .hero-bottom-line {
    position: absolute;
    z-index: 3;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 25px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px 20px;
    color: rgba(255, 255, 255, .55);
    font: 400 9px/1.6 var(--mono);
    letter-spacing: .08em;
  }

  /* INTRO */

  .intro {
    display: grid;
    grid-template-columns: .8fr 1.2fr;
    gap: 8vw;
    padding-block: clamp(90px, 12vw, 165px);
  }

  .intro-aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 15px;
  }

  .intro-aside p {
    color: var(--muted);
    font: 400 11px/1.7 var(--mono);
    letter-spacing: .03em;
  }

  .intro-content {
    min-width: 0;
  }

  .intro-content h2 {
    max-width: 800px;
    margin: 0 0 28px;
    font: 600 clamp(36px, 5vw, 68px)/1.17 var(--display);
    letter-spacing: -.055em;
    text-wrap: balance;
  }

  .intro-content h2 span {
    display: block;
    color: var(--forest-3);
  }

  .intro-content > p {
    max-width: 590px;
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.9;
    text-wrap: pretty;
  }

  /* SERVICES */

  .services {
    padding-block: clamp(80px, 10vw, 140px);
    background: var(--paper-2);
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;
    margin-bottom: 55px;
  }

  .section-heading h2 {
    margin: 15px 0 0;
    font: 600 clamp(42px, 6vw, 78px)/1.12 var(--display);
    letter-spacing: -.06em;
    text-wrap: balance;
  }

  .section-heading > p {
    max-width: 340px;
    margin: 0 0 5px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.85;
  }

  .service-list {
    border-top: 1px solid var(--line);
  }

  .service-row {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr) 45px;
    align-items: center;
    gap: 22px;
    padding: 25px 0;
    border-bottom: 1px solid var(--line);
    transition: padding .25s, background .25s;
  }

  .service-row:hover {
    padding-inline: 12px;
    background: rgba(255, 255, 255, .36);
  }

  .service-icon {
    width: 46px;
    height: 46px;
  }

  .service-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .service-copy strong {
    font: 700 clamp(21px, 3vw, 34px)/1.25 var(--display);
    letter-spacing: -.04em;
  }

  .service-copy small {
    max-width: 500px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.75;
  }

  .service-arrow {
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 50%;
    display: grid;
    place-items: center;
    transition: transform .25s, background .25s;
  }

  .service-arrow img {
    width: 18px;
    height: 18px;
  }

  .service-row:hover .service-arrow {
    background: var(--lime);
    transform: rotate(45deg);
  }

  /* PRINCIPLES */

  .field-note {
    padding-block: clamp(85px, 11vw, 150px);
    background: var(--forest);
    color: var(--white);
    position: relative;
    overflow: hidden;
  }

  .field-note::after {
    content: 'B';
    position: absolute;
    right: -.05em;
    bottom: -.45em;
    color: rgba(255, 255, 255, .035);
    font: 800 min(55vw, 780px)/1 var(--display);
    letter-spacing: -.12em;
    pointer-events: none;
  }

  .field-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: 8vw;
  }

  .field-heading .section-label {
    color: var(--lime);
  }

  .field-heading h2 {
    max-width: 570px;
    margin: 22px 0;
    font: 600 clamp(40px, 5.7vw, 74px)/1.15 var(--display);
    letter-spacing: -.055em;
    text-wrap: balance;
  }

  .field-heading h2 span {
    display: block;
    color: var(--lime);
  }

  .field-heading p {
    max-width: 360px;
    color: rgba(255, 255, 255, .75);
    font-size: 14px;
    line-height: 1.9;
  }

  .principle-list {
    border-top: 1px solid rgba(255, 255, 255, .22);
  }

  .principle {
    padding: 26px 0;
    border-bottom: 1px solid rgba(255, 255, 255, .22);
  }

  .principle h3 {
    margin: 0 0 10px;
    font: 700 24px/1.3 var(--display);
    letter-spacing: -.035em;
  }

  .principle p {
    max-width: 440px;
    margin: 0;
    color: rgba(255, 255, 255, .75);
    font-size: 13px;
    line-height: 1.85;
  }

  /* MATERIALS */

  .materials {
    padding-block: clamp(85px, 11vw, 150px);
    background: #e9e9dc;
  }

  .materials-heading {
    margin-bottom: 50px;
  }

  .material-grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
  }

  .material-card {
    grid-column: span 2;
    min-height: 270px;
    min-width: 0;
    padding: 25px;
    background: var(--paper);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    transition: transform .25s, background .25s;
  }

  .material-card:nth-child(4) {
    grid-column: 2 / span 2;
  }

  .material-card:nth-child(5) {
    grid-column: 4 / span 2;
  }

  .material-card:hover {
    transform: translateY(-4px);
    background: var(--white);
  }

  .material-icon {
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    display: grid;
    place-items: center;
  }

  .material-icon img {
    width: 20px;
    height: 20px;
  }

  .material-copy {
    width: 100%;
    min-width: 0;
  }

  .material-card h3 {
    margin: 0 0 10px;
    font: 700 clamp(21px, 2.6vw, 30px)/1.25 var(--display);
    letter-spacing: -.045em;
  }

  .material-card p {
    max-width: 290px;
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.8;
  }

  .material-link {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--forest-3);
    font-size: 12px;
    font-weight: 700;
  }

  .material-link img {
    width: 14px;
    height: 14px;
  }

  /* CLOSING */

  .closing {
    padding-block: clamp(75px, 10vw, 130px);
    background: var(--lime);
  }

  .closing-inner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 35px;
  }

  .closing h2 {
    max-width: 850px;
    margin: 18px 0 0;
    font: 700 clamp(45px, 7.5vw, 100px)/1.15 var(--display);
    letter-spacing: -.065em;
    text-wrap: balance;
  }

  .closing h2 span {
    display: block;
    color: var(--forest-3);
  }

  .button-dark {
    min-height: 52px;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    padding: 15px 19px;
    background: var(--forest);
    color: var(--white);
    font-size: 13px;
    font-weight: 700;
    transition: transform .25s;
  }

  .button-dark:hover {
    transform: translateY(-3px);
  }

  .button-dark img {
    width: 16px;
    height: 16px;
  }

  /* FOOTER */

  .site-footer {
    padding: 60px 0 25px;
    background: var(--forest);
    color: var(--white);
  }

  .footer-main {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 50px;
    padding-bottom: 65px;
  }

  .footer-logo span {
    font-size: 22px;
  }

  .footer-brand > p {
    max-width: 340px;
    margin-top: 23px;
    color: rgba(255, 255, 255, .72);
    font-size: 13px;
    line-height: 1.9;
  }

  .footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
  }

  .footer-label {
    margin-bottom: 7px;
    color: var(--lime);
    font: 400 10px/1.5 var(--mono);
    letter-spacing: .12em;
  }

  .footer-column a {
    color: rgba(255, 255, 255, .78);
    font-size: 13px;
    line-height: 1.6;
    transition: color .2s;
  }

  .footer-column a:hover {
    color: var(--lime);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px 24px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, .18);
  }

  .footer-bottom p {
    margin: 0;
    color: rgba(255, 255, 255, .62);
    font: 400 10px/1.7 var(--mono);
    letter-spacing: .04em;
  }

  /* FLOATING REPORT BUTTON */

  .report-button {
    position: fixed;
    z-index: 40;
    right: 22px;
    bottom: 22px;
    min-height: 58px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    padding: 15px 23px;
    border-radius: 999px;
    background: var(--lime);
    color: var(--forest);
    box-shadow: 0 8px 28px rgba(16, 44, 36, .22);
    font-size: 14px;
    font-weight: 700;
    transition: transform .2s, box-shadow .2s, background .2s;
  }

  .report-button:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(16, 44, 36, .28);
    background: #e5f16e;
  }

  .report-button img {
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
  }

  /* TABLET */

  @media (max-width: 1050px) {
    .header-inner {
      gap: 16px;
    }

    .main-navigation {
      gap: 14px;
    }

    .nav-link,
    .explore-trigger {
      font-size: 12px;
    }

    .hero-art {
      width: 100vw;
      left: 58%;
      opacity: .3;
    }

    .material-card {
      padding: 20px;
    }
  }

  /* MOBILE NAVIGATION */

  @media (max-width: 900px) {
    .site-header,
    .header-inner {
      min-height: 70px;
    }

    .mobile-toggle {
      position: relative;
      z-index: 60;
      width: 46px;
      height: 46px;
      flex: 0 0 46px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(255, 255, 255, .35);
      border-radius: 50%;
      background: var(--forest);
      cursor: pointer;
    }

    .mobile-toggle img {
      width: 21px;
      height: 21px;
    }

    .toggle-close {
      display: none;
    }

    .mobile-toggle[aria-expanded="true"] .toggle-open {
      display: none;
    }

    .mobile-toggle[aria-expanded="true"] .toggle-close {
      display: block;
    }

    .main-navigation {
      position: fixed;
      z-index: 55;
      inset: 0;
      width: 100%;
      height: 100vh;
      height: 100dvh;
      padding: 100px var(--gutter) 40px;
      background: var(--forest);
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: flex-start;
      gap: 0;
      overflow-y: auto;
      overscroll-behavior: contain;
      visibility: hidden;
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity .25s, transform .25s, visibility .25s;
    }

    .main-navigation.is-open {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
    }

    .nav-link {
      padding: 17px 0;
      border-bottom: 1px solid rgba(255, 255, 255, .17);
      font: 600 25px/1.35 var(--display);
      letter-spacing: -.035em;
    }

    .explore-menu {
      min-height: 0;
      display: block;
      border-bottom: 1px solid rgba(255, 255, 255, .17);
    }

    .explore-trigger {
      width: 100%;
      justify-content: space-between;
      padding: 18px 0;
      font: 600 25px/1.35 var(--display);
      letter-spacing: -.035em;
    }

    .explore-trigger img {
      width: 19px;
      height: 19px;
    }

    .explore-dropdown {
      position: static;
      display: none;
      width: 100%;
      padding: 0 0 15px;
      background: transparent;
      border: 0;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .explore-menu.is-expanded .explore-dropdown {
      display: block;
    }

    .dropdown-heading {
      padding: 0 0 12px;
      border-color: rgba(255, 255, 255, .2);
    }

    .dropdown-heading > span {
      color: var(--lime);
    }

    .dropdown-heading p {
      color: rgba(255, 255, 255, .72);
    }

    .dropdown-item {
      border-color: rgba(255, 255, 255, .15);
      padding-block: 14px;
    }

    .dropdown-icon {
      background: rgba(255, 255, 255, .12);
    }

    .dropdown-icon img {
      filter: brightness(0) saturate(100%) invert(91%) sepia(47%) saturate(590%) hue-rotate(13deg);
    }

    .dropdown-copy strong {
      color: white;
    }

    .dropdown-copy small {
      color: rgba(255, 255, 255, .72);
    }

    .dropdown-arrow {
      filter: brightness(0) invert(1);
    }

    .sign-in-link {
      align-self: flex-start;
      margin-top: 24px;
      min-height: 46px;
      font-size: 13px;
    }

    /* Hero mobile dibuat lebih rapat dan fokus pada teks */
    .hero {
      min-height: 0;
      min-height: 100svh;
      padding: 112px var(--gutter) 78px;
      align-items: center;
    }

    .hero-content {
      margin-top: 0;
    }

    .hero-art {
      width: 115vw;
      left: 58%;
      top: 48%;
      opacity: .23;
    }

    .hero-eyebrow {
      max-width: 100%;
      align-items: flex-start;
      gap: 10px;
      font-size: 9px;
      line-height: 1.8;
      margin-bottom: 22px;
    }

    .status-dot {
      margin-top: 5px;
    }

    .hero h1 {
      max-width: 100%;
      font-size: clamp(42px, 9.5vw, 68px);
      line-height: 1.16;
      letter-spacing: -.045em;
      text-wrap: pretty;
    }

    .hero-description {
      max-width: 100%;
      margin-top: 22px;
    }

    .hero-description p {
      font-size: 14px;
      line-height: 1.8;
    }

    .hero-bottom-line {
      bottom: 17px;
      font-size: 8px;
      line-height: 1.7;
      gap: 8px 14px;
    }

    .intro {
      grid-template-columns: .7fr 1.3fr;
      gap: 5vw;
    }

    .field-inner {
      grid-template-columns: 1fr 1.1fr;
      gap: 5vw;
    }

    .footer-main {
      grid-template-columns: 1fr 1fr;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  /* MOBILE */

  @media (max-width: 600px) {
    :root {
      --gutter: 22px;
    }

    .header-inner {
      padding-inline: var(--gutter);
    }

    .brand span {
      font-size: 19px;
    }

    .hero {
      min-height: 0;
      min-height: 100svh;
      padding: 112px var(--gutter) 76px;
      align-items: center;
    }

    .hero-content {
      transform: translateY(-8px);
    }

    .hero-art {
      width: 135vw;
      max-width: none;
      left: 52%;
      top: 44%;
      opacity: .2;
    }

    .hero-eyebrow {
      max-width: 310px;
      align-items: flex-start;
      gap: 10px;
      font-size: 8px;
      line-height: 1.8;
      margin-bottom: 22px;
    }

    .hero h1 {
      max-width: 100%;
      font-size: clamp(40px, 10.3vw, 59px);
      line-height: 1.17;
      letter-spacing: -.045em;
      text-wrap: pretty;
    }

    .hero h1 em {
      white-space: nowrap;
    }

    .hero-description {
      max-width: 100%;
      margin-top: 23px;
    }

    .hero-description p {
      font-size: 14px;
      line-height: 1.8;
    }

    .hero-bottom-line {
      bottom: 16px;
      font-size: 7px;
      line-height: 1.7;
      gap: 7px 12px;
    }

    .intro {
      grid-template-columns: 1fr;
      gap: 25px;
      padding-block: 78px;
    }

    .intro-content h2 {
      font-size: clamp(35px, 9vw, 46px);
      line-height: 1.2;
      letter-spacing: -.045em;
      margin-bottom: 22px;
    }

    .intro-content h2 span {
      margin-top: 2px;
    }

    .intro-content > p {
      font-size: 14px;
      line-height: 1.9;
    }

    .services,
    .materials {
      padding-block: 78px;
    }

    .section-heading {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
      margin-bottom: 35px;
    }

    .section-heading h2 {
      font-size: clamp(40px, 10vw, 52px);
