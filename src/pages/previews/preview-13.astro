        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: end;
        gap: 44px;
      }

      .hero__description p {
        max-width: 520px;
        margin: 0;
        color: var(--muted);
        font-size: 15px;
        line-height: 1.82;
      }

      .hero__actions {
        display: flex;
        align-items: center;
        gap: 23px;
      }

      .hero-field {
        height: 610px;
        will-change: transform;
      }

      .hero-field__frame {
        height: 100%;
        position: relative;
        padding: 18px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: var(--forest);
        color: white;
        overflow: hidden;
      }

      .hero-field__frame::before {
        content: "";
        position: absolute;
        inset: 0;
        opacity: .17;
        background:
          linear-gradient(rgba(255,255,255,.18) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255,255,255,.18) 1px, transparent 1px);
        background-size: 34px 34px;
        animation: fieldGrid 22s linear infinite;
      }

      @keyframes fieldGrid {
        to { background-position: 0 68px, 68px 0; }
      }

      .hero-field__caption,
      .hero-field__legend {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        gap: 14px;
        color: rgba(255,255,255,.46);
        font-size: 7px;
        letter-spacing: .09em;
      }

      .field-figure {
        position: relative;
        width: min(100%, 420px);
        aspect-ratio: 1;
        margin-inline: auto;
        display: grid;
        place-items: center;
        transform: rotate(-5deg);
      }

      .field-figure__ring {
        position: absolute;
        border: 1px solid rgba(255,255,255,.28);
        border-radius: 50%;
      }

      .field-figure__ring--outer {
        width: 88%;
        height: 88%;
        animation: ringTurn 18s linear infinite;
      }

      .field-figure__ring--mid {
        width: 64%;
        height: 64%;
        border-style: dashed;
        animation: ringTurn 11s linear reverse infinite;
      }

      .field-figure__ring--inner {
        width: 37%;
        height: 37%;
        border-color: rgba(182,218,61,.55);
      }

      @keyframes ringTurn {
        to { transform: rotate(360deg); }
      }

      .field-figure__cross {
        position: absolute;
        background: rgba(255,255,255,.16);
      }

      .field-figure__cross--h {
        width: 100%;
        height: 1px;
      }

      .field-figure__cross--v {
        width: 1px;
        height: 100%;
      }

      .field-figure__marker {
        position: absolute;
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background: var(--acid);
        box-shadow: 0 0 0 6px rgba(182,218,61,.08);
        animation: markerPulse 2.8s ease-in-out infinite;
      }

      .field-figure__marker--a { left: 22%; top: 39%; animation-delay: 0s; }
      .field-figure__marker--b { left: 64%; top: 27%; animation-delay: .55s; }
      .field-figure__marker--c { left: 57%; top: 67%; animation-delay: 1.1s; }

      @keyframes markerPulse {
        50% { box-shadow: 0 0 0 12px rgba(182,218,61,0); }
      }

      .field-figure__label {
        position: absolute;
        padding: 6px 7px;
        border: 1px solid rgba(255,255,255,.18);
        color: rgba(255,255,255,.68);
        background: rgba(23,32,27,.36);
        font-size: 7px;
        letter-spacing: .08em;
      }

      .field-figure__label--a { left: 9%; top: 32%; }
      .field-figure__label--b { right: 7%; top: 20%; }
      .field-figure__label--c { right: 10%; bottom: 23%; }

      .field-figure__path {
        position: absolute;
        inset: 8%;
        width: 84%;
        height: 84%;
        overflow: visible;
      }

      .field-figure__path path {
        stroke: var(--clay);
        stroke-width: 3;
        stroke-linecap: round;
        stroke-dasharray: 1200;
        stroke-dashoffset: 1200;
        animation: drawPath 2.7s .9s var(--ease) forwards;
      }

      @keyframes drawPath {
        to { stroke-dashoffset: 0; }
      }

      .field-figure__center {
        position: relative;
        z-index: 2;
        width: 58px;
        height: 58px;
        display: grid;
        place-items: center;
        border: 1px solid var(--acid);
        border-radius: 50%;
        color: var(--acid);
        font-family: var(--sans);
        font-size: 24px;
        font-weight: 700;
      }

      .hero__base {
        min-height: 68px;
        display: grid;
        grid-template-columns: repeat(3, 1fr) auto;
        border-top: 1px solid var(--ink);
      }

      .hero__base-item,
      .hero__base-scroll {
        min-height: 68px;
        display: flex;
        align-items: center;
      }

      .hero__base-item {
        gap: 12px;
        padding-left: 18px;
        border-right: 1px solid var(--line);
      }

      .hero__base-item small {
        color: var(--clay);
        font-size: 7px;
      }

      .hero__base-item span,
      .hero__base-scroll span {
        font-size: 7px;
        letter-spacing: .07em;
      }

      .hero__base-scroll {
        gap: 12px;
        padding-left: 20px;
        color: #88847b;
      }

      .hero__scroll-arrow {
        color: var(--clay);
        font-size: 14px !important;
      }

      /* INTRO BAND */
      .intro-band {
        padding: 150px 0 165px;
        background: var(--white);
        border-bottom: 1px solid var(--line);
      }

      .intro-band__grid {
        display: grid;
        grid-template-columns: 190px minmax(0, 1fr);
        gap: 54px;
      }

      .intro-band__content {
        max-width: 1000px;
      }

      .intro-band__content .eyebrow {
        margin: 0 0 24px;
        color: var(--forest);
        font-size: 8px;
        letter-spacing: .12em;
      }

      .intro-band__body {
        max-width: 840px;
        margin-top: 46px;
        display: grid;
        grid-template-columns: repeat(2, minmax(0,1fr));
        gap: 40px;
      }

      .intro-band__body p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.84;
      }

      /* ROUTE BOOK */
      .route-book {
        padding: 145px 0 160px;
        background: var(--paper);
      }

      .route-list {
        border-top: 1px solid var(--ink);
      }

      .route-item {
        min-height: 185px;
        display: grid;
        grid-template-columns: 72px 100px minmax(0,1fr) 110px;
        align-items: center;
        gap: 27px;
        padding: 20px 0;
        border-bottom: 1px solid var(--line);
        transition: background .35s ease, padding .35s var(--ease), border-color .35s ease;
        will-change: transform;
      }

      .route-item:hover {
        padding-inline: 18px;
        background: var(--paper-2);
      }

      .route-item__no {
        align-self: start;
        padding-top: 10px;
        color: #8f8a80;
        font-family: var(--mono);
        font-size: 9px;
      }

      .route-item__icon {
        width: 76px;
        height: 76px;
        display: grid;
        place-items: center;
        border: 1px solid var(--ink);
        background: var(--white);
        transition: transform .45s var(--ease), background .3s ease, color .3s ease;
      }

      .route-item:hover .route-item__icon {
        transform: rotate(-7deg) scale(1.05);
        background: var(--forest);
        color: #fff;
      }

      .route-item__icon svg {
        width: 43px;
        height: 43px;
        stroke: currentColor;
        stroke-width: 1.5;
        vector-effect: non-scaling-stroke;
      }

      .route-item__copy {
        min-width: 0;
      }

      .route-item__tag {
        display: block;
        margin-bottom: 10px;
        color: #8a857c;
        font-size: 7px;
        letter-spacing: .1em;
      }

      .route-item__copy h3 {
        margin: 0;
        font-size: clamp(28px, 3vw, 41px);
        line-height: 1;
        letter-spacing: -.045em;
      }

      .route-item__copy p {
        max-width: 660px;
        margin: 15px 0 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.72;
      }

      .route-item__action {
        justify-self: end;
        display: grid;
        justify-items: end;
        gap: 10px;
        color: var(--clay);
        font-size: 7px;
        letter-spacing: .08em;
      }

      .route-item__arrow {
        font-family: var(--sans);
        font-size: 27px;
        line-height: 1;
      }

      /* DARK CHAPTER */
      .dark-chapter {
        position: relative;
        padding: 148px 0 168px;
        background: var(--ink);
        color: #fff;
        overflow: hidden;
      }

      .dark-chapter__noise {
        position: absolute;
        inset: 0;
        opacity: .08;
        pointer-events: none;
        background-image:
          radial-gradient(circle at 1px 1px, #fff 1px, transparent 0);
        background-size: 7px 7px;
      }

      .dark-chapter__inner {
        position: relative;
        z-index: 1;
      }

      .light-copy {
        max-width: 600px;
        margin: 28px 0 0;
        color: rgba(255,255,255,.58);
        font-size: 15px;
        line-height: 1.78;
      }

      .method-sequence {
        position: relative;
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        border-top: 1px solid var(--line-dark);
      }

      .method-sequence__line {
        position: absolute;
        top: -1px;
        left: 0;
        right: 0;
        height: 1px;
        overflow: hidden;
      }

      .method-sequence__line span {
        display: block;
        width: 27%;
        height: 100%;
        background: var(--acid);
        animation: methodLine 5s ease-in-out infinite;
      }

      @keyframes methodLine {
        0%, 100% { transform: translateX(-120%); }
        55% { transform: translateX(370%); }
      }

      .method-step {
        position: relative;
        min-height: 385px;
        padding: 25px 31px 34px 0;
        border-right: 1px solid var(--line-dark);
      }

      .method-step + .method-step {
        padding-left: 31px;
      }

      .method-step:last-child {
        border-right: 0;
      }

      .method-step__index {
        color: rgba(255,255,255,.38);
        font-family: var(--mono);
        font-size: 9px;
      }

      .method-step__symbol {
        position: relative;
        width: 94px;
        height: 94px;
        margin-top: 64px;
      }

      .method-step__symbol span,
      .method-step__symbol i {
        position: absolute;
        display: block;
      }

      .method-step__symbol--find span {
        inset: 18px;
        border: 1px solid rgba(255,255,255,.8);
        border-radius: 50%;
      }

      .method-step__symbol--find i {
        width: 25px;
        height: 25px;
        left: 34px;
        top: 34px;
        border: 1px solid var(--acid);
        background: var(--ink);
        border-radius: 50%;
      }

      .method-step__symbol--read span:first-child {
        width: 67px;
        height: 42px;
        left: 4px;
        top: 7px;
        border: 1px solid rgba(255,255,255,.75);
      }

      .method-step__symbol--read span:nth-child(2) {
        width: 67px;
        height: 42px;
        left: 22px;
        top: 25px;
        border: 1px solid rgba(255,255,255,.35);
      }

      .method-step__symbol--read i {
        width: 28px;
        height: 3px;
        left: 34px;
        top: 50px;
        background: var(--clay);
      }

      .method-step__symbol--connect span {
        width: 13px;
        height: 13px;
        border: 1px solid var(--acid);
        border-radius: 50%;
      }

      .method-step__symbol--connect span:nth-child(1) { left: 7px; top: 39px; }
      .method-step__symbol--connect span:nth-child(2) { left: 41px; top: 12px; }
      .method-step__symbol--connect span:nth-child(3) { left: 68px; top: 54px; }

      .method-step__symbol--connect i {
        left: 17px;
        top: 39px;
        width: 51px;
        height: 1px;
        background: rgba(255,255,255,.44);
        transform: rotate(-18deg);
        transform-origin: left center;
      }

      .method-step__copy {
        margin-top: 35px;
      }

      .method-step__copy small {
        color: rgba(255,255,255,.36);
        font-size: 7px;
        letter-spacing: .09em;
      }

      .method-step__copy h3 {
        margin: 14px 0 0;
        font-size: 35px;
        letter-spacing: -.045em;
      }

      .method-step__copy p {
        max-width: 320px;
        margin: 13px 0 0;
        color: rgba(255,255,255,.52);
        font-size: 13px;
        line-height: 1.72;
      }

      /* QUESTIONS */
      .question-index {
        padding: 144px 0 158px;
        background: var(--white);
      }

      .question-stack {
        border-top: 1px solid var(--ink);
      }

      .question-row {
        min-height: 107px;
        display: grid;
        grid-template-columns: 74px minmax(0,1fr) 145px 36px;
        align-items: center;
        gap: 22px;
        border-bottom: 1px solid var(--line);
        transition: padding .35s var(--ease), background .35s ease;
      }

      .question-row:hover {
        padding-inline: 16px;
        background: var(--paper);
      }

      .question-row__no {
        color: #8b867d;
        font-size: 8px;
      }

      .question-row strong {
        font-size: clamp(20px, 2.3vw, 29px);
        letter-spacing: -.035em;
      }

      .question-row__route {
        color: var(--forest);
        font-size: 7px;
        letter-spacing: .09em;
      }

      .question-row__arrow {
        justify-self: end;
        color: var(--clay);
        font-size: 22px;
      }

      /* AREA / TERRITORY */
      .territory {
        padding: 148px 0 170px;
        background: var(--paper-2);
        border-bottom: 1px solid var(--line);
      }

      .territory__grid {
        display: grid;
        grid-template-columns: 190px minmax(0,1fr);
        gap: 54px;
      }

      .territory__main {
        min-width: 0;
      }

      .territory-stage {
        position: relative;
        height: 490px;
        overflow: hidden;
        background: #b8b4aa;
        border: 1px solid var(--ink);
      }

      .territory-stage__sky {
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, #d7d1c4 0%, #c4bfb4 57%, #aaa69c 100%);
      }

      .territory-stage__sun {
        position: absolute;
        width: 145px;
        height: 145px;
        right: 15%;
        top: 11%;
        border-radius: 50%;
        background: var(--gold);
        opacity: .9;
        animation: sunFloat 8s ease-in-out infinite;
      }

      @keyframes sunFloat {
        50% { transform: translate3d(0, 12px, 0); }
      }

      .territory-stage__terrain {
        position: absolute;
        left: -4%;
        width: 108%;
        border-radius: 50% 50% 0 0;
      }

      .terrain-one {
        height: 250px;
        bottom: -85px;
        background: var(--forest);
        transform: rotate(-2deg);
      }

      .terrain-two {
        height: 190px;
        bottom: -52px;
        background: var(--forest-2);
        transform: rotate(3deg);
      }

      .terrain-three {
        height: 125px;
        bottom: -20px;
        background: var(--acid);
        opacity: .75;
        transform: rotate(-1deg);
      }

      .territory-stage__axis {
        position: absolute;
        width: 1px;
        height: 75%;
        top: 11%;
        background: rgba(255,255,255,.52);
      }

      .axis-one { left: 27%; transform: rotate(28deg); transform-origin: center; }
      .axis-two { right: 37%; transform: rotate(-25deg); transform-origin: center; }

      .territory-stage__label {
        position: absolute;
        padding: 6px 8px;
        border: 1px solid rgba(21,22,19,.46);
        background: rgba(244,240,231,.82);
        font-family: var(--mono);
        font-size: 7px;
        letter-spacing: .08em;
      }

      .label-kuta { left: 16%; top: 36%; }
      .label-mengwi { left: 49%; top: 47%; }
      .label-abian { right: 11%; top: 60%; }

      .territory-stage__caption {
        position: absolute;
        left: 17px;
        top: 17px;
        color: rgba(21,22,19,.65);
        font-size: 7px;
        letter-spacing: .08em;
      }

      .territory-stage__coordinate {
        position: absolute;
        right: 17px;
        bottom: 17px;
        text-align: right;
        color: rgba(21,22,19,.55);
        font-size: 7px;
        line-height: 1.6;
        letter-spacing: .08em;
      }

      .territory-table {
        margin-top: 28px;
        border-top: 1px solid var(--ink);
      }

      .territory-table__head,
      .territory-row {
        display: grid;
        grid-template-columns: 90px minmax(0,1fr) 180px 150px;
        align-items: center;
        gap: 20px;
      }

      .territory-table__head {
        min-height: 45px;
        color: #8a857d;
        font-size: 7px;
        letter-spacing: .08em;
        border-bottom: 1px solid var(--line);
      }

      .territory-row {
        min-height: 84px;
        border-bottom: 1px solid var(--line);
        transition: padding .3s var(--ease), background .3s ease;
      }

      .territory-row:hover {
        padding-inline: 12px;
        background: var(--paper);
      }

      .territory-row > span:first-child {
        color: #8c877e;
        font-family: var(--mono);
        font-size: 8px;
      }

      .territory-row div {
        display: grid;
        gap: 5px;
      }

      .territory-row strong {
        font-size: 18px;
        letter-spacing: -.025em;
      }

      .territory-row small {
        color: var(--muted);
        font-size: 10px;
      }

      .territory-row > span:nth-child(3),
      .territory-row > span:nth-child(4) {
        font-family: var(--mono);
        font-size: 7px;
        letter-spacing: .06em;
      }

      .territory-row > span:nth-child(4) {
        color: var(--forest);
      }

      .territory-row--more {
        min-height: 62px;
        grid-template-columns: 90px minmax(0,1fr) 180px 150px;
        color: var(--forest);
      }

      .territory-row--more strong {
        font-size: 13px;
      }

      .territory-row--more > span:last-child {
        color: var(--clay);
        justify-self: end;
      }

      /* MATERIAL INDEX */
      .material-library {
        padding: 148px 0 172px;
        background: var(--white);
      }

      .material-library__grid {
        display: grid;
        grid-template-columns: 190px minmax(0,1fr);
        gap: 54px;
      }

      .material-library__main {
        min-width: 0;
      }

      .material-gallery {
        display: grid;
        grid-template-columns: minmax(0,.92fr) minmax(0,1.08fr);
        gap: 26px;
      }

      .material-gallery__feature {
        position: relative;
        min-height: 535px;
        overflow: hidden;
        background: var(--forest);
        color: #fff;
      }

      .material-gallery__feature::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 42%, rgba(0,0,0,.26) 100%);
      }

      .material-gallery__feature-top {
        position: absolute;
        inset: 17px 18px auto;
        z-index: 4;
        display: flex;
        justify-content: space-between;
        color: rgba(255,255,255,.48);
        font-size: 7px;
        letter-spacing: .09em;
      }

      .material-gallery__feature-code {
        position: absolute;
        z-index: 4;
        left: 20px;
        bottom: 104px;
        font-size: 78px;
        line-height: .8;
        letter-spacing: -.08em;
        font-weight: 800;
      }

      .material-gallery__feature-title {
        position: absolute;
        z-index: 4;
        left: 20px;
        bottom: 50px;
        font-size: 28px;
        letter-spacing: -.045em;
        font-weight: 700;
      }

      .material-gallery__feature-note {
        position: absolute;
        z-index: 4;
        right: 20px;
        bottom: 23px;
        color: rgba(255,255,255,.5);
        font-size: 7px;
        letter-spacing: .08em;
      }

      .material-orb {
        position: absolute;
        border-radius: 50%;
        mix-blend-mode: screen;
      }

      .material-orb--one {
        width: 270px;
        height: 270px;
        top: 17%;
        left: 8%;
        background: radial-gradient(circle at 35% 30%, rgba(182,218,61,.92), rgba(182,218,61,0) 64%);
        animation: orbFloatA 7s ease-in-out infinite;
      }

      .material-orb--two {
        width: 210px;
        height: 210px;
        right: 6%;
        top: 33%;
        background: radial-gradient(circle at 50% 50%, rgba(211,106,72,.9), rgba(211,106,72,0) 68%);
        animation: orbFloatB 8s ease-in-out infinite;
      }

      .material-orb--three {
        width: 310px;
        height: 310px;
        left: 25%;
        bottom: -8%;
        background: radial-gradient(circle at 50% 50%, rgba(197,166,106,.56), rgba(197,166,106,0) 67%);
        animation: orbFloatC 10s ease-in-out infinite;
      }

      @keyframes orbFloatA { 50% { transform: translate(18px,-12px) scale(1.05); } }
      @keyframes orbFloatB { 50% { transform: translate(-12px,17px) scale(.95); } }
      @keyframes orbFloatC { 50% { transform: translate(0,-22px) scale(1.07); } }

      .material-gallery__list {
        border-top: 1px solid var(--ink);
      }

      .material-card {
        min-height: 104px;
        display: grid;
        grid-template-columns: 45px 68px minmax(0,1fr) 155px 22px;
        gap: 15px;
        align-items: center;
        border-bottom: 1px solid var(--line);
        transition: padding .3s var(--ease), background .3s ease;
      }

      .material-card:hover {
        padding-inline: 14px;
        background: var(--paper);
      }

      .material-card__no,
      .material-card__code {
        color: #8a857c;
        font-size: 7px;
        letter-spacing: .06em;
      }

      .material-card__code {
        color: var(--forest);
      }

      .material-card strong {
        font-size: 18px;
        letter-spacing: -.025em;
      }

      .material-card small {
        color: var(--muted);
        font-size: 10px;
        line-height: 1.5;
      }

      .material-card__arrow {
        justify-self: end;
        color: var(--clay);
        font-size: 18px;
      }

      /* PRINCIPLES */
      .principles-book {
        padding: 148px 0 170px;
        background: var(--paper-2);
        border-top: 1px solid var(--line);
      }

      .principles-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        border-top: 1px solid var(--ink);
      }

      .principle-card {
        min-height: 355px;
        padding: 24px 30px 32px 0;
        border-right: 1px solid var(--line);
        transition: transform .35s var(--ease), background .3s ease;
        will-change: transform;
      }

      .principle-card + .principle-card {
        padding-left: 29px;
      }

      .principle-card:last-child {
        border-right: 0;
      }

      .principle-card:hover {
        background: var(--paper);
      }

      .principle-card__top {
        display: flex;
        justify-content: space-between;
        color: #8b867d;
        font-size: 8px;
      }

      .principle-card__top span:first-child {
        color: var(--clay);
      }

      .principle-card__glyph {
        position: relative;
        width: 110px;
        height: 90px;
        margin-top: 52px;
      }

      .principle-card__glyph span,
      .principle-card__glyph i,
      .principle-card__glyph b {
        position: absolute;
        display: block;
      }

      .principle-card:nth-child(1) .principle-card__glyph span {
        width: 34px;
        height: 34px;
        border: 1px solid var(--forest);
        border-radius: 50%;
      }

      .principle-card:nth-child(1) .principle-card__glyph span:nth-child(1) { left: 5px; top: 27px; }
      .principle-card:nth-child(1) .principle-card__glyph span:nth-child(2) { left: 35px; top: 7px; }
      .principle-card:nth-child(1) .principle-card__glyph span:nth-child(3) { left: 65px; top: 31px; }

      .principle-card:nth-child(2) .principle-card__glyph i {
        width: 68px;
        height: 13px;
        border: 1px solid var(--ink);
      }

      .principle-card:nth-child(2) .principle-card__glyph i:nth-child(1) { top: 6px; left: 7px; }
      .principle-card:nth-child(2) .principle-card__glyph i:nth-child(2) { top: 31px; left: 20px; background: var(--white); }
      .principle-card:nth-child(2) .principle-card__glyph i:nth-child(3) { top: 56px; left: 33px; background: var(--acid); }
      .principle-card:nth-child(2) .principle-card__glyph i:nth-child(4) { top: 81px; left: 46px; }

      .principle-card:nth-child(3) .principle-card__glyph b {
        width: 26px;
        height: 26px;
        border: 1px solid var(--clay);
        transform: rotate(45deg);
      }

      .principle-card:nth-child(3) .principle-card__glyph b:nth-child(1) { left: 12px; top: 28px; }
      .principle-card:nth-child(3) .principle-card__glyph b:nth-child(2) { left: 43px; top: 9px; }
      .principle-card:nth-child(3) .principle-card__glyph b:nth-child(3) { left: 66px; top: 41px; background: var(--clay); }

      .principle-card h3 {
        margin: 25px 0 0;
        font-size: 29px;
        letter-spacing: -.04em;
      }

      .principle-card p {
        max-width: 330px;
        margin: 13px 0 0;
        color: var(--muted);
        font-size: 13px;
        line-height: 1.74;
      }

      /* PUBLIC CONTRIBUTION */
      .public-action {
        padding: 42px 0 0;
        background: var(--clay);
        color: #fff;
      }

      .public-action__inner {
        min-height: 585px;
        padding-bottom: 47px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
      }

      .public-action__top,
      .public-action__footer {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        color: rgba(255,255,255,.62);
        font-size: 7px;
        letter-spacing: .08em;
      }

      .public-action__body {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 80px;
      }

      .public-action__copy {
        max-width: 790px;
      }

      .eyebrow--light {
        color: rgba(255,255,255,.58);
      }

      .public-action__copy h2 {
        margin: 24px 0 0;
        font-size: clamp(62px, 7.3vw, 110px);
        line-height: .86;
        letter-spacing: -.08em;
      }

      .public-action__copy h2 em {
        color: #fff;
        font-family: var(--serif);
        font-style: italic;
        font-weight: 500;
      }

      .public-action__copy > p:last-child {
        max-width: 520px;
        margin: 31px 0 0;
        color: rgba(255,255,255,.72);
        font-size: 14px;
        line-height: 1.75;
      }

      .action-button {
        min-width: 335px;
        min-height: 106px;
        padding: 12px;
        display: grid;
        grid-template-columns: 58px minmax(0,1fr) 24px;
        align-items: center;
        gap: 14px;
        background: var(--ink);
        color: #fff;
        transition: transform .35s var(--ease), background .3s ease;
      }

      .action-button:hover {
        background: var(--forest);
      }

      .action-button__symbol {
        width: 58px;
        height: 58px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(255,255,255,.17);
        font-size: 28px;
        font-weight: 300;
      }

      .action-button__copy {
        display: grid;
        gap: 6px;
      }

      .action-button__copy small {
        color: rgba(255,255,255,.42);
        font-family: var(--mono);
        font-size: 7px;
        letter-spacing: .08em;
      }

      .action-button__copy strong {
        font-size: 17px;
        letter-spacing: -.02em;
      }

      .action-button__arrow {
        font-size: 21px;
      }

      /* FOOTER */
      .footer {
        background: var(--ink);
        color: #fff;
      }

      .footer__main {
        padding: 85px 0 78px;
        display: grid;
        grid-template-columns: minmax(0,1fr) 150px 170px 180px;
        gap: 62px;
      }

      .brand--footer .brand__seal span:nth-child(1) { background: #fff; }
      .brand--footer .brand__seal span:nth-child(2) { background: var(--clay); }
      .brand--footer .brand__seal span:nth-child(3) { background: #6e9988; }
      .brand--footer .brand__seal span:nth-child(4) { background: var(--acid); }

      .brand--footer .brand__lockup strong { color: #fff; }
      .brand--footer .brand__lockup small { color: rgba(255,255,255,.34); }

      .footer__identity p {
        max-width: 390px;
        margin: 25px 0 0;
        color: rgba(255,255,255,.45);
        font-size: 13px;
        line-height: 1.75;
      }

      .footer__column {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
      }

      .footer__label {
        margin-bottom: 18px;
        color: rgba(255,255,255,.28);
        font-size: 7px;
        letter-spacing: .1em;
      }

      .footer__column a {
        margin-bottom: 11px;
        color: rgba(255,255,255,.68);
        font-size: 12px;
        transition: color .2s ease;
      }

      .footer__column a:hover {
        color: #fff;
      }

      .footer__column--end strong {
        font-size: 13px;
        letter-spacing: -.01em;
      }

      .footer__column--end small {
        margin-top: 10px;
        color: rgba(255,255,255,.38);
        font-family: var(--mono);
        font-size: 7px;
        letter-spacing: .08em;
      }

      .footer__base {
        min-height: 62px;
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        border-top: 1px solid rgba(255,255,255,.11);
        color: rgba(255,255,255,.28);
        font-size: 7px;
        letter-spacing: .06em;
      }

      .footer__base span:nth-child(2) {
        color: rgba(255,255,255,.5);
      }

      .footer__base span:last-child {
        text-align: right;
      }

      /* FLOATING REPORT */
      .floating-report {
        position: fixed;
        right: 22px;
        bottom: 20px;
        z-index: 250;
        min-height: 61px;
        padding: 7px 11px 7px 8px;
        display: inline-grid;
        grid-template-columns: 45px minmax(0,1fr) 20px;
        align-items: center;
        gap: 10px;
        background: var(--ink);
        color: #fff;
        box-shadow: 0 16px 45px rgba(0,0,0,.15);
        transition: transform .35s var(--ease), background .25s ease;
      }

      .floating-report:hover {
        background: var(--forest);
        transform: translateY(-3px);
      }

      .floating-report__icon {
        width: 45px;
        height: 45px;
        display: grid;
        place-items: center;
        border: 1px solid rgba(255,255,255,.15);
        color: var(--acid);
        font-size: 23px;
        font-weight: 300;
      }

      .floating-report__copy {
        display: grid;
        gap: 5px;
      }

      .floating-report small {
        color: rgba(255,255,255,.4);
        font-size: 6px;
        letter-spacing: .08em;
      }

      .floating-report strong {
        font-size: 11px;
      }

      .floating-report__arrow {
        color: var(--clay);
        font-size: 18px;
      }

      /* RESPONSIVE LARGE */
      @media (max-width: 1180px) {
        .shell {
          width: min(calc(100% - 48px), var(--page));
        }

        .hero__canvas {
          grid-template-columns: minmax(0,1fr) 390px;
          gap: 45px;
        }

        .hero-field {
          height: 540px;
        }

        .hero__description {
          grid-template-columns: 1fr;
          gap: 26px;
        }

        .hero__actions {
          justify-content: flex-start;
        }

        .route-item {
          grid-template-columns: 55px 84px minmax(0,1fr) 90px;
          gap: 21px;
        }

        .territory-table__head,
        .territory-row {
          grid-template-columns: 70px minmax(0,1fr) 150px 130px;
        }

        .material-card {
          grid-template-columns: 35px 60px minmax(0,1fr) 130px 20px;
        }

        .public-action__body {
          gap: 45px;
        }

        .action-button {
          min-width: 300px;
        }
      }

      /* RESPONSIVE TABLET */
      @media (max-width: 940px) {
        .shell {
          width: min(calc(100% - 40px), var(--page));
        }

        .header__inner {
          grid-template-columns: auto 1fr auto;
        }

        .header-nav {
          display: none;
        }

        .menu-trigger {
          display: grid;
          place-items: center;
        }

        .hero__canvas {
          min-height: auto;
          padding-block: 70px 80px;
          grid-template-columns: 1fr;
        }

        .hero__copy {
          padding-block: 20px 0;
        }

        .hero-field {
          width: min(100%, 620px);
          height: 510px;
          margin-left: auto;
        }

        .hero__base {
          grid-template-columns: repeat(3, 1fr);
        }

        .hero__base-scroll {
          display: none;
        }

        .intro-band__grid,
        .territory__grid,
        .material-library__grid,
        .section-header {
          grid-template-columns: 125px minmax(0,1fr);
          gap: 32px;
        }

        .route-item {
          grid-template-columns: 45px 75px minmax(0,1fr) 75px;
          gap: 16px;
        }

        .route-item__icon {
          width: 64px;
          height: 64px;
        }

        .method-sequence {
          grid-template-columns: 1fr;
        }

        .method-step,
        .method-step + .method-step {
          min-height: 310px;
          padding: 24px 0 34px;
          border-right: 0;
          border-bottom: 1px solid var(--line-dark);
        }

        .method-step:last-child {
          border-bottom: 0;
        }

        .method-step__symbol {
          margin-top: 45px;
        }

        .territory-stage {
          height: 420px;
        }

        .material-gallery {
          grid-template-columns: 1fr;
        }

        .material-gallery__feature {
          min-height: 430px;
        }

        .principles-grid {
          grid-template-columns: 1fr;
        }

        .principle-card,
        .principle-card + .principle-card {
          min-height: 290px;
          padding: 26px 0 34px;
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }

        .principle-card:last-child {
          border-bottom: 0;
        }

        .public-action__body {
          align-items: flex-start;
          flex-direction: column;
        }

        .footer__main {
          grid-template-columns: 1fr 1fr;
        }

        .footer__column--end {
          align-items: flex-start;
        }
      }

      /* RESPONSIVE MOBILE */
      @media (max-width: 640px) {
        .shell {
          width: calc(100% - 28px);
        }

        .display {
          font-size: clamp(48px, 15vw, 74px);
        }

        .display--medium {
          font-size: clamp(40px, 12vw, 58px);
        }

        .header__inner {
          min-height: 72px;
        }

        .brand__seal {
          width: 26px;
          height: 26px;
        }

        .brand__lockup strong {
          font-size: 14px;
        }

        .brand__lockup small,
        .header-meta > span {
          display: none;
        }

        .menu-trigger {
          width: 40px;
          height: 40px;
        }

        .hero {
          padding-top: 72px;
        }

        .hero__topline {
          min-height: 44px;
          grid-template-columns: 1fr auto;
        }

        .hero__topline span:nth-child(2) {
          display: none;
        }

        .hero__canvas {
          padding-block: 56px 46px;
          gap: 44px;
        }

        .hero__copy .eyebrow {
          margin-bottom: 19px;
        }

        .hero-title {
          font-size: clamp(58px, 17vw, 90px);
          line-height: .82;
        }

        .hero__description {
          margin-top: 37px;
        }

        .hero__description p {
          font-size: 13px;
          line-height: 1.72;
        }

        .hero__actions {
          align-items: stretch;
          flex-direction: column;
        }

        .button {
          width: 100%;
        }

        .hero-field {
          width: 100%;
          height: auto;
          margin: 0;
        }

        .hero-field__frame {
          aspect-ratio: 1 / 1.12;
          min-height: 430px;
        }

        .field-figure {
          width: min(100%, 300px);
        }

        .hero__base {
          min-height: auto;
          grid-template-columns: 1fr;
          border-top: 1px solid var(--ink);
        }

        .hero__base-item {
          min-height: 52px;
          border-right: 0;
          border-bottom: 1px solid var(--line);
        }

        .hero__base-scroll {
          display: flex;
          min-height: 52px;
        }

        .intro-band,
        .route-book,
        .question-index,
        .territory,
        .material-library,
        .principles-book {
          padding-block: 94px 105px;
        }

        .intro-band__grid,
        .territory__grid,
        .material-library__grid,
        .section-header {
          grid-template-columns: 1fr;
          gap: 24px;
        }

        .section-marker {
          flex-direction: row;
          align-items: baseline;
          justify-content: space-between;
          border-bottom: 1px solid var(--line);
          padding-bottom: 13px;
        }

        .section-header {
          margin-bottom: 48px;
        }

        .intro-band__body {
          margin-top: 32px;
          grid-template-columns: 1fr;
          gap: 20px;
        }

        .route-item {
          min-height: 0;
          padding: 21px 0 25px;
          grid-template-columns: 34px 60px minmax(0,1fr) 25px;
          gap: 10px;
        }

        .route-item:hover {
          padding-inline: 7px;
        }

        .route-item__icon {
          width: 57px;
          height: 57px;
        }

        .route-item__icon svg {
          width: 33px;
          height: 33px;
        }

        .route-item__no {
          padding-top: 4px;
        }

        .route-item__copy h3 {
          font-size: 20px;
        }

        .route-item__copy p {
          font-size: 11px;
          line-height: 1.62;
        }

        .route-item__tag {
          margin-bottom: 6px;
          font-size: 6px;
        }

        .route-item__action span:first-child {
          display: none;
        }

        .route-item__arrow {
          font-size: 20px;
        }

        .dark-chapter {
          padding-block: 96px 108px;
        }

        .method-step__symbol {
          margin-top: 40px;
        }

        .method-step__copy h3 {
          font-size: 30px;
        }

        .question-row {
          min-height: 92px;
          grid-template-columns: 33px minmax(0,1fr) 70px 22px;
          gap: 10px;
        }

        .question-row:hover {
          padding-inline: 8px;
        }

        .question-row strong {
          font-size: 16px;
        }

        .question-row__route {
          font-size: 6px;
        }

        .territory-stage {
          height: 340px;
        }

        .territory-stage__sun {
          width: 96px;
          height: 96px;
        }

        .territory-table__head {
          display: none;
        }

        .territory-row,
        .territory-row--more {
          min-height: 88px;
          grid-template-columns: 34px minmax(0,1fr) auto;
          gap: 10px;
        }

        .territory-row > span:nth-child(3) {
          display: none;
        }

        .territory-row > span:nth-child(4) {
          font-size: 6px;
        }

        .territory-row--more {
          grid-template-columns: 34px minmax(0,1fr) auto;
        }

        .territory-row--more > span:last-child {
          grid-column: 3;
        }

        .material-gallery__feature {
          min-height: 360px;
        }

        .material-gallery__feature-code {
          font-size: 64px;
        }

        .material-gallery__feature-title {
          font-size: 24px;
        }

        .material-card {
          min-height: 90px;
          grid-template-columns: 30px 50px minmax(0,1fr) 20px;
          gap: 8px;
        }

        .material-card small {
          display: none;
        }

        .material-card strong {
          font-size: 15px;
        }

        .material-card__arrow {
          font-size: 16px;
        }

        .principle-card h3 {
          font-size: 25px;
        }

        .public-action {
          padding-top: 31px;
        }

        .public-action__inner {
          min-height: 620px;
          padding-bottom: 35px;
        }

        .public-action__top,
        .public-action__footer {
          flex-direction: column;
          gap: 7px;
        }

        .public-action__copy h2 {
          font-size: clamp(53px, 15vw, 82px);
        }

        .action-button {
          width: 100%;
          min-width: 0;
        }

        .footer__main {
          grid-template-columns: 1fr;
          gap: 42px;
          padding-block: 64px 58px;
        }

        .footer__column--end {
          padding-top: 7px;
          border-top: 1px solid rgba(255,255,255,.1);
        }

        .footer__base {
          min-height: auto;
          padding: 16px 0 24px;
          grid-template-columns: 1fr;
          gap: 10px;
        }

        .footer__base span:last-child,
        .footer__base span:nth-child(2) {
          text-align: left;
        }

        .floating-report {
          right: 14px;
          bottom: 14px;
          width: 52px;
          height: 52px;
          min-height: 52px;
          padding: 0;
          display: grid;
          place-items: center;
          grid-template-columns: 1fr;
          gap: 0;
          border-radius: 0;
        }

        .floating-report__icon {
          width: 52px;
          height: 52px;
          border: 0;
          font-size: 25px;
        }

        .floating-report__copy,
        .floating-report__arrow {
          display: none;
        }

        .cursor-follower {
          display: none;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *, *::before, *::after {
          animation-duration: .001ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: .001ms !important;
        }

        .reveal {
          opacity: 1;
          transform: none;
        }
      }
      /* MICRO-INTERACTIONS / FIELD STATES -------------------------------- */
      .hero-reveal {
        opacity: 0;
        transform: translateY(18px);
        animation: heroMetaIn .9s .55s var(--ease) forwards;
      }

      @keyframes heroMetaIn {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .hero__description.reveal {
        opacity: 0;
        transform: translateY(24px);
        animation: heroDescriptionIn .95s .62s var(--ease) forwards;
      }

      @keyframes heroDescriptionIn {
        to {
          opacity: 1;
          transform: translateY(0);
        }
      }
      .hero-field__frame:hover .field-figure__ring--outer {
        border-color: rgba(255,255,255,.42);
      }

      .hero-field__frame:hover .field-figure__ring--mid {
        border-color: rgba(182,218,61,.55);
      }

      .hero-field__frame:hover .field-figure__path path {
        stroke: #fff;
      }
      .hero-field__frame:hover::before {
        opacity: .25;
      }
      .route-item[data-hover-card]::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        width: 3px;
        height: 0;
        background: var(--clay);
        transition: height .45s var(--ease);
      }

      .route-item[data-hover-card] {
        position: relative;
      }

      .route-item[data-hover-card]:hover::before {
        height: 100%;
      }
      .method-step::after {
        content: "";
        position: absolute;
        left: 0;
        right: 31px;
        bottom: 0;
        height: 2px;
        transform: scaleX(0);
        transform-origin: left center;
        background: var(--acid);
        transition: transform .6s var(--ease);
      }

      .method-step:hover::after {
        transform: scaleX(1);
      }
      .method-step:hover .method-step__symbol--find span {
        animation: methodFindPulse 1.7s ease-in-out infinite;
      }

      @keyframes methodFindPulse {
        50% { transform: scale(1.12); }
      }
      .method-step:hover .method-step__symbol--read span:first-child {
        transform: translateY(-4px);
      }

      .method-step:hover .method-step__symbol--read span:nth-child(2) {
        transform: translateY(4px);
      }
      .method-step:hover .method-step__symbol--connect span:nth-child(2) {
        animation: nodeUp 1.6s ease-in-out infinite;
      }

      @keyframes nodeUp {
        50% { transform: translateY(-6px); }
      }
      .question-row__arrow {
        transition: transform .35s var(--ease), color .2s ease;
      }

      .question-row:hover .question-row__arrow {
        transform: translate(3px,-3px) rotate(4deg);
      }
      .territory-stage:hover .territory-stage__terrain {
        transform-origin: center bottom;
      }

      .territory-stage:hover .terrain-one {
        transform: rotate(-2deg) translateY(-8px);
      }

      .territory-stage:hover .terrain-two {
        transform: rotate(3deg) translateY(-4px);
      }

      .territory-stage:hover .terrain-three {
        transform: rotate(-1deg) translateY(-2px);
      }
      .material-gallery__feature:hover .material-orb--one {
        animation-duration: 4s;
      }

      .material-gallery__feature:hover .material-orb--two {
        animation-duration: 5s;
      }

      .material-gallery__feature:hover .material-orb--three {
        animation-duration: 6s;
      }
      .material-card::before {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 2px;
        background: var(--forest);
        transform: scaleY(0);
        transform-origin: center top;
        transition: transform .45s var(--ease);
      }

      .material-card {
        position: relative;
      }

      .material-card:hover::before {
        transform: scaleY(1);
      }
      .principle-card__glyph {
        transition: transform .6s var(--ease);
      }

      .principle-card:hover .principle-card__glyph {
        transform: translateY(-3px);
      }

      .principle-card:nth-child(1):hover .principle-card__glyph span:nth-child(1) {
        transform: translate(3px,-2px);
      }

      .principle-card:nth-child(1):hover .principle-card__glyph span:nth-child(3) {
        transform: translate(-3px,2px);
      }
      .principle-card:nth-child(2):hover .principle-card__glyph i:nth-child(2) {
        transform: translateX(7px);
      }

      .principle-card:nth-child(2):hover .principle-card__glyph i:nth-child(3) {
        transform: translateX(14px);
      }
      .principle-card:nth-child(3):hover .principle-card__glyph b:nth-child(3) {
        transform: rotate(45deg) scale(1.15);
      }
      .public-action__copy,
      .action-button {
        will-change: transform;
      }

      .action-button__symbol {
        transition: transform .45s var(--ease), color .25s ease, border-color .25s ease;
      }

      .action-button:hover .action-button__symbol {
        transform: rotate(45deg);
        border-color: rgba(182,218,61,.35);
        color: var(--acid);
      }
      .floating-report__icon {
        transition: transform .35s var(--ease);
      }

      .floating-report:hover .floating-report__icon {
        transform: rotate(90deg);
      }
      .footer__column a,
      .footer__identity p,
      .footer__column strong,
      .footer__column small {
        transition: transform .25s var(--ease), color .2s ease;
      }

      .footer__column a:hover {
        transform: translateX(4px);
      }
      .header.is-scrolled .brand__seal {
        transform: rotate(-2deg);
      }

      .header.is-scrolled .brand__lockup small {
        color: var(--forest);
      }
      .header__inner .brand,
      .header-nav a,
      .header-meta,
      .menu-trigger {
        transition: transform .35s var(--ease), opacity .25s ease, color .2s ease;
      }

      .header__inner .brand:hover {
        transform: translateY(-1px);
      }
      @media (max-width: 640px) {
        .hero__description.reveal,
        .hero-reveal {
          animation-delay: .45s;
        }

        .method-step::after {
          right: 0;
        }

        .territory-stage:hover .terrain-one,
        .territory-stage:hover .terrain-two,
        .territory-stage:hover .terrain-three {
          transform: none;
        }
      }
